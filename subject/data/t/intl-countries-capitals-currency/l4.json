সিডেন্ট নিকোলাস মাদুরো ও তাঁর স্ত্রী সিলিয়া ফ্লোরেসকে আটক করে। অন্য তিন রাজধানী: প্যারাগুয়ের আসুনসিওন, চিলির সান্তিয়াগো, কলম্বিয়ার বোগোতা।","id":"q62a85a3c1d","t":"l","s":""},{"q":"রিঙ্গিত কোন দেশের মুদ্রা?","o":["মিয়ননমার","থাইল্যান্ড","মালয়েশিয়া","ভুটান"],"a":2,"e":"","id":"q6af3c62723","t":"l","s":""},{"q":"'ওয়ার্‌শ' নিচের কোন দেশের রাজধানী?","o":["কাজাখস্তান","বেলারুশ","পোল্যান্ড","পর্তুগাল"],"a":2,"e":"","id":"q6d55a94887","t":"l","s":""},{"q":"আশখাবাদ কোন দেশের রাজধানী শহর?","o":["তুর্কমেনিস্তান","তাজিকিস্তান","উজবেকিস্তান","কিরগিজস্তান"],"a":0,"e":"","id":"q6eb6673a85","t":"l","s":""},{"q":"জাপানের রাজধানীর নাম কী?","o":["সিউল","নিপ্পন","কিয়োটো","টোকিও"],"a":3,"e":"","id":"q73407a45ed","t":"l","s":""},{"q":"‘দুশান্বে’ কোন দেশের রাজধানী?","o":["তাজিকিস্তান","উজবেকিস্তান","কিরঘিজিস্তান","কাজাখস্তান"],"a":0,"e":"","id":"q73594439ff","t":"l","s":""},{"q":"মালয়েশিয়ার মুদ্রা-","o":["রিঙ্গিত","লিরা","বেলবোয়া","কিয়াট"],"a":0,"e":"","id":"q79924af8d2","t":"l","s":""},{"q":"'উইন্ডহোক' নিচের কোন দেশের রাজধানী?","o":["নামিবিয়া","সাও তোমে অ্যান্ড প্রিন্সিপে","মোজাম্বিক","নাইজার"],"a":0,"e":"","id":"q7e9ac60c6e","t":"l","s":""},{"q":"উরুগুয়ের রাজধানীর নাম কি?","o":["মন্টেভিডিও","বোগোতা","সন্টিয়াগো","বুয়েন্স আয়ার্স"],"a":0,"e":"","id":"q829751c685","t":"l","s":""},{"q":"হাইতির রাজধানীর নাম কী?","o":["সেন্ট জোন্স","পোর্ট অব স্পেন","পোর্ট অব প্রিন্স","ব্রিজটাউন"],"a":2,"e":"","id":"q835c60806c","t":"l","s":""},{"q":"চিলির রাজধানী কোনটি?","o":["হাভানা","মন্টেভিডিও","বুয়েনোস আইরেস","সান্টিয়াগো"],"a":3,"e":"","id":"q878975526d","t":"l","s":""},{"q":"জাপানের সরকারি মুদ্রার নাম কী?","o":["রিঙ্গিত","ওন","ইয়েন","ইউয়ান"],"a":2,"e":"","id":"q8852822260","t":"l","s":""}]
