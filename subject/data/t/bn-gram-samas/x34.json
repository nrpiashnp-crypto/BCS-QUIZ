[{"q":"'মৌমাছি' কোন সমাস (মৌ সংগ্রহকারী মাছি)?","o":["তৎপুরুষ","অব্যয়ীভাব","কর্মধারয়","দ্বিগু"],"a":2,"e":"ব্যাসবাক্যের মাঝের 'সংগ্রহকারী' পদটি লোপ পেয়েছে, তাই এটি মধ্যপদলোপী কর্মধারয় সমাস।","id":"qdb2b97e89e","t":"x","s":"প্রাথমিক শিক্ষা অধিদপ্তর, সহকারী শিক্ষক (কর্ণফুলী) (২০১২)"},{"q":"'ঈগল পাখী' কোন সমাস (ঈগল নামের যে পাখী)?","o":["কর্মধারয়","তৎপুরুষ","অব্যয়ীভাব","বহুব্রীহি"],"a":0,"e":"<p>'ঈগল পাখি' সমাসবদ্ধ পদে পূর্বপদ 'ঈগল' ও পরপদ 'পাখি' একই বস্তুকে বোঝাচ্ছে এবং পরপদের অর্থই প্রধান, তাই এটি কর্মধারয় সমাস। ব্যাসবাক্য 'ঈগল নামের যে পাখি' থেকে বোঝা যায় যে নাম ও জাতি একাত্ম হয়েছে, যেমন শাল গাছ, ইলিশ মাছ। তৎপুরুষে পূর্বপদের বিভক্তি লোপ পায় (বিপদকে আপন্ন = বিপদাপন্ন), অব্যয়ীভাবে পূর্বপদ অব্যয় ও তার অর্থ প্রধান (উপকূল), আর বহুব্রীহিতে তৃতীয় অর্থ প্রধান হয় (নীলকণ্ঠ)। এখানে এসব লক্ষণ নেই। কর্মধারয়ের প্রসিদ্ধ উদাহরণ: নীলপদ্ম (যা নীল তা-ই পদ্ম), মহাত্মা।</p>","id":"qdbe2baad42","t":"x","s":""},{"q":"'নিঃসহায়' ---শব্দটি কোন সমাস ?","o":["অলুক দ্বন্দ্ব","ষষ্ঠী তৎপুরুষ","অব্যয়ীভাব","বহুব্রীহি"],"a":3,"e":"","id":"qdcb839eaca","t":"x","s":""},{"q":"কোনটি কর্মধারয় সমাসের উদাহরণ?","o":["ইন্দ্রজিৎ","একরোখা","কালান্তর","ইহকাল"],"a":3,"e":"'ইহকাল' = ইহ যে কাল; বিশেষণ ও বিশেষ্য মিলে বিশেষ্যের অর্থ প্রধান হয়েছে, তাই কর্মধারয় সমাস। ইন্দ্রজিৎ উপপদ তৎপুরুষ, একরোখা বহুব্রীহি আর কালান্তর নিত্য সমাস।","id":"qdd9d01bad2","t":"x","s":"প্রাথমিক শিক্ষা অধিদপ্তর, সহকারী শিক্ষক (সুরমা) (২০১০)"},{"q":"উপপদের সাথে কৃদন্ত পদের যে সমাস হয় তাকে কোন সমাস বলে?","o":["উপপদ তৎপুরুষ","উপমান","কর্মধারয়","উপমিত"],"a":0,"e":"","id":"qe01f72464c","t":"x","s":""},{"q":"'কীটপতঙ্গ' কোন ধরনের দ্বন্দ্ব সমাস?","o":["বিপরীতার্থক দ্বন্দ্ব","একশেষ দ্বন্দ্ব","সমার্থক দ্বন্দ্ব","অলুক দ্বন্দ্ব"],"a":2,"e":"","id":"qe0b8dea6e3","t":"x","s":""},{"q":"'বহুব্রীহি' কোন সমাস?","o":["কর্মধারয়","অব্যয়ীভাব","বহুব্রীহি","প্রাদী সমাস"],"a":2,"e":"","id":"qe0c37d0336","t":"x","s":""},{"q":"কোনটি কর্মধারয় সমাস?","o":["হাভাতে","নীলাকাশ","মনগড়া","মাতৃসেবা"],"a":1,"e":"","id":"qe15f05578d","t":"x","s":""},{"q