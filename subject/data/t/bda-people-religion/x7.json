[{"q":"তাফসীর ফি যিলালিল কুরআনএর লেখক কে?","o":["মুফতী মুহাম্মাদ শফী (দাঃ)","সাইয়্যিদ কুতুব","ইবনে কাসীর (রঃ)","মাও তকী উসমানী"],"a":1,"e":"","id":"q732204e285","t":"x","s":""},{"q":"মহানবী (সঃ) ব্যবসার উদ্দেশ্যে কোন দেশে গিয়েছিলেন?","o":["ইরাক","আবিসিনিয়া","মিশর","সিরিয়া"],"a":3,"e":"<p>মহানবী (সা.) ব্যবসার উদ্দেশ্যে সিরিয়ায় গিয়েছিলেন। মাত্র ১২ বছর বয়সে চাচা আবু তালিবের সঙ্গে তিনি প্রথম সিরিয়া সফর করেন। পরে খাদিজা (রা.)-এর বাণিজ্যিক কাফেলা নিয়েও তিনি সিরিয়ায় যান, যার পর তাঁদের বিয়ে হয়। আবিসিনিয়ায় (ইথিওপিয়া) হিজরত করেছিলেন প্রথম যুগের কিছু সাহাবি, মহানবী নিজে নন।</p>","id":"q743edb8b22","t":"x","s":""},{"q":"সালাতুল জানাজা আদায় করা ---","o":["সুন্নাতে মুয়াক্কাদা","ওয়াজিব","ফরজে কেফায়া","ফরজে আইন"],"a":2,"e":"","id":"q7603581f2d","t":"x","s":""},{"q":"হযরত ইব্রাহীম (আঃ) এর উপর কতটি সহীফা অবতীর্ণ হয়?","o":["১০টি","৯টি","১১টি","১২টি"],"a":0,"e":"","id":"q7a7990e08d","t":"x","s":""},{"q":"পর্দা করা-","o":["নারী-পুরুষের জন্য ফরয","পুরুষের জন্য ওয়াজিব","নারী-পুরুষের জন্য ওয়াজিব","নারীর জন্য ফরয"],"a":0,"e":"","id":"q7d26134893","t":"x","s":""},{"q":"পবিত্র কুরআনে হরকত যুক্ত করেন কে?","o":["হাজ্জাজ বিন ইউসুফ","মহানবী (স)","হজরত উসমান (রা)","উমর ইবনে আব্দুল আজীজ"],"a":0,"e":"","id":"q7d2fdd7f05","t":"x","s":""},{"q":"ইসলামিক শিল্পকলার নকশা ডিজাইনের উপাদান কয়টি?","o":["২টি","৫টি","৩টি","৪টি"],"a":1,"e":"","id":"q7eabd65fe5","t":"x","s":""},{"q":"মুসলিম জাতির পিতা ----","o":["ইব্রাহিম (আ)","মুহাম্মদ (সা)","ইসমাঈল (আ)","আদম (আ)"],"a":0,"e":"","id":"q7ef4bb0381","t":"x","s":""},{"q":"আল কুরআনের প্রথম সূরা কোনটি?","o":["সুরা ফাতেহা","সুরা ইখলাস","সুরা বাকারা","সুরা ইমরান"],"a":0,"e":"","id":"q8136b34b6f","t":"x","s":""},{"q":"মহানবী উটনীর নাম কি?","o":["ইয়াসরিয়া","মাইসারা","খাজিলা","কাসওয়া"],"a":3,"e":"<p>মহানবী (সা.)-এর প্রিয় উটনীর নাম কাসওয়া, একে চড়েই তিনি হিজরতের সময় মদিনায় পৌঁছান। মদিনায় কাসওয়া যেখানে বসেছিল, সেখানেই মসজিদে নববী নির্মিত হয় বলে বর্ণিত আছে। মহানবীর ঘোড়ার নাম মুরতাজিজ, আর খচ্চরের নাম দুলদুল। মাইসারা ছিলেন খাদিজা (রা.)-এর ক্র