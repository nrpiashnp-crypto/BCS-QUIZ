[{"q":"a 2 = 7 + 4√3 হলে a + 1/a এর মান কত?","o":["2√3","4","4√3","2"],"a":1,"e":"","id":"q919fe82132","t":"l","s":""},{"q":"(a + 2)(a - 2) কে (a + 3)(a - 3) দিয়ে ভাগ করলে ভাগশেষ কত?","o":["0","5","-5","14"],"a":1,"e":"","id":"q91b2544705","t":"l","s":""},{"q":"x + y = 8 এবং x 2 + y 2 = 34 হলে, x 3 + y 3 এর মান কত?","o":["154","156","166","152"],"a":3,"e":"","id":"q921d6d3cf4","t":"l","s":""},{"q":"If p + q = √7 and p - q = √5, what is the value of 8pq(p 2 + q 2 )?","o":["49","40","34","24"],"a":3,"e":"দুটি সূত্র কাজে লাগে: 4pq = (p + q)² − (p − q)² = 7 − 5 = 2 এবং 2(p² + q²) = (p + q)² + (p − q)² = 7 + 5 = 12। 8pq(p² + q²) = 4pq × 2(p² + q²) = 2 × 12 = 24।","id":"q922b522ca3","t":"l","s":""},{"q":"দুটি সংখ্যার পার্থক্য 4 এবং সংখ্যা দুটির গুণফল 60 হলে, সংখ্যা দুটির যোগফল কত?","o":["16","12","14","10"],"a":0,"e":"","id":"q92c8bd63a4","t":"l","s":""},{"q":"x + 1/x = 2, y - 1/y = 3 হলে, x 2 + y 2 +(1/x 2 ) + (1/y 2 ) এর মান কত?","o":["14","13","12","11"],"a":1,"e":"","id":"q92df2af921","t":"l","s":""},{"q":"যদি a + b = 3 এবং ab = 2 হয়, তবে b এর মান কত?","o":["1, 5","1, 4","1, 3","1, 2"],"a":3,"e":"","id":"q92ee4aed63","t":"l","s":""},{"q":"a = 1 + √2 হলে a 3 - 5√2 = কত?","o":["5","7","8","6"],"a":1,"e":"","id":"q9302a54901","t":"l","s":""},{"q":"x + 1/x = √3 হলে, {(x 6 + 1)/x 3 } + 1 এর মান কত?","o":["3√3","1","- 1","0"],"a":1,"e":"","id":"q93637b20d0","t":"l","s":""},{"q":"যদি a + b = 5 এবং ab = 10 হয়, তাহলে a 2 + b 2 এর মান কত?","o":["45","10","5","50"],"a":2,"e":"","id":"q938bbe40a5","t":"l","s":""},{"q":"x - 1/x = √5 হলে x + 1/x এর মান কত?","o":["√3","1/3","3","3√3"],"a":2,"e":"","id":"q93978177ab","t":"l","s":""},{"q":"যদি a + b = √8 এবং a - b = √6 হলে, 8ab(a 2 + b 2 ) = কত?","o":["24","32","28","48"],"a":2,"e":"","id":"q93a5b94a7a","t":"l","s":""},{"q":"1/(2-x) এর সাথে কত যোগ করলে যোগফল (x-3)/(x-2) হবে?","o":["1","0","-1","x"],"a":0,"e":"","id":"q93fb7d033d","t":"l","s":""},{"q":"যদি xy = 8 হয়, তাহলে (x + y) 2 - (x - y) 2 এর মান কত?","o":["48","32","0","16"],"a":1,"e":"","id":"q94627e9b7d","t":"l","s":""},{"q":"x - 2 = √3 হলে x 4 + 1/x 4 এর মান কত?","o":["196","198","194","192"],"a":2,"e":"<p>x − ২ = √৩ হলে x = ২ + √৩।<br>১/x = ১/(২ + √৩) = (২ − √৩)/(৪ − ৩) = ২ − √৩<br>x + ১/x = (২ + √৩) + (২ − √৩) = ৪<br>x² + ১/x² = (x + ১/x)² − ২ = ১৬ − ২ = ১৪<br>x⁴ + ১/x⁴ = (x² + ১/x²)² − ২ = ১৯৬ − ২ = ১৯৪<br>১৯৬ উত্তরটি আসে শেষ ধাপে ২ বাদ দিতে ভুলে গেলে, আর ১৯৮ আসে ভুল করে ২ যোগ করলে।<br>লক্ষ করুন, (২ + √৩)(২ − √৩) = ১ হওয়ায়ই ১/x = ২ − √৩ এত সহজে পাওয়া গেছে।<br>শর্টকাট: x + ১/x = k হলে x⁴ + ১/x⁴ = (k² − ২)² − ২ = (১৬ − ২)² − ২ = ১৯৪।</p>","id":"q9476f9e384","t":"l","s":""},{"q":"2 (2x + 2) = 8 (x + 3) হলে, x এর মান কত?","o":["9","- 2","- 7","4"],"a":2,"e":"","id":"q9485f7eafe","t":"l","s":""},{"q":"যদি x 2 - 3x + 1 = 0 হয়, তবে (x 2 + 1/x 2 )-এর মান কত?","o":["11","7","5","9"],"a":1,"e":"","id":"q94e59d809e","t":"l","s":""},{"q":"- 6m - [3n - {8m - (4n - 10m)}] simplifies to","o":["12m - 7n","11m - 7n","- 12m - 7n","12m + 7n"],"a":0,"e":"ভেতরের বন্ধনী থেকে শুরু করে বাইরের দিকে খুলতে হয়। (4n - 10m)-এর সামনে বিয়োগ থাকায় 8m - 4n + 10m = 18m - 4n। তখন 3n - (18m - 4n) = 7n - 18m। এখন -6m - (7n - 18m) = -6m - 7n + 18m = 12m - 7n।","id":"q952ec6cae5","t":"l","s":""},{"q":"বিন্দু P = (- 1, 4) এবং Q = (3, -2) -এর মধ্যবিন্দু কত?","o":["(1, 1)","(-1, 1)","(2, - 1)","(0, 0)"],"a":0,"e":"","id":"q9575dcb37c","t":"l","s":""},{"q":"a 2 = 25, b 2 = 36 এবং a > b হলে (a - b) 2 = ?","o":["1","0","100","11"],"a":0,"e":"","id":"q95d45b9378","t":"l","s":""}]
