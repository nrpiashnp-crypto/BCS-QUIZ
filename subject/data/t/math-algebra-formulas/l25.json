[{"q":"If √x = √3 - √5 then the value of x 2 - 16x + 6 is?","o":["1","2","3","None of these"],"a":1,"e":"বর্গ করে x = (√3 - √5)² = 8 - 2√15, তাই x - 8 = -2√15। আবার বর্গ করলে x² - 16x + 64 = 60, অর্থাৎ x² - 16x = -4। অতএব x² - 16x + 6 = -4 + 6 = 2।","id":"q5f1e6bc5dc","t":"l","s":""},{"q":"a = 2 + √3 হলে a 3 + 3a + 3/a + 1/a 3 = ?","o":["48","64","8","16"],"a":1,"e":"","id":"q5f8578fae0","t":"l","s":""},{"q":"a + b + c = 0 হলে, a 3 + b 3 + c 3 = ?","o":["ab + bc + ca","3abc","a 2 + b 2 + c 2 + ab +bc + ca","a 2 + b 2 + c 2 - ab - bc - ca"],"a":1,"e":"","id":"q5fa0a2fa1c","t":"l","s":""},{"q":"a + b = 10 এবং ab = 16 হলে, a 2 + b 2 + 8ab = কত?","o":["196","182","190","188"],"a":0,"e":"","id":"q5fd2d330e4","t":"l","s":""},{"q":"x 3 = 26 - 15√3 হলে x 2 - (1/x 2 ) এর মান কত?","o":["24","- 8√3","16√3","14"],"a":1,"e":"","id":"q5fda678545","t":"l","s":""},{"q":"X ও Y দুইটি স্বাধীন ঘটনা এবং P(X) = 2/3, P(Y) = 3/4 হলে, P(X ∩ Y) এর মান কত?","o":["3","1/4","1/2","2"],"a":2,"e":"","id":"q60281a12c5","t":"l","s":""},{"q":"x - {x - x - (x - 1)} + 1 এর মান কত?","o":["x + 1","2x","1","x"],"a":1,"e":"","id":"q609d3f7db1","t":"l","s":""},{"q":"x 2 + 3x + 2 , x 2 - 1 এবং x 2 + x - 2 এর ল.সা.গু কত?","o":["(x + 3)(x + 2)(x - 1)","(x + 2)(x + 1)(x - 3)","(x + 2)(x + 1)(x - 2)","(x + 2)(x + 1)(x - 1)"],"a":3,"e":"","id":"q60c8d5c0c2","t":"l","s":""},{"q":"যদি x 2 + (1/x 2 ) = 7 হয়, তবে x 3 + (1/x 3 ) এর মান কত? [যেখানে x > 0]","o":["18","36","54","27"],"a":0,"e":"","id":"q60f6a1b10b","t":"l","s":""},{"q":"x 2 - 4x + 4 = 0 হলে, (x 4 + 2x 2 + 1)/ x 2 এর মান কত?","o":["9/4","25/4","4","1/4"],"a":1,"e":"","id":"q61b1c10e4f","t":"l","s":""},{"q":"2x + (2/x) = 6 হলে, x 2 + 1/x 2 এর মান-","o":["7","3","5","9"],"a":0,"e":"","id":"q6241f87b2a","t":"l","s":""},{"q":"x + 3 1/3 + 3 2/3 = 0 হলে, x 3 + 12-এর মান কত?","o":["12x","9x","6x","9"],"a":1,"e":"","id":"q62431e301f","t":"l","s":""},{"q":"2 + x + y + 16 গুণোত্তর ধারাভুক্ত হলে, xy এর মান কত?","o":["40","56","32","24"],"a":2,"e":"","id":"q6293538d02","t":"l","s":""},{"q":"If x 2 - √5.x + 1 = 0 then, x 2 + 1/x 2 = ?","o":["9","2","3","5"],"a":2,"e":"x² − √5x + 1 = 0 থেকে x² + 1 = √5x। x দিয়ে ভাগ করলে x + 1/x = √5 পাওয়া যায়। বর্গ করে x² + 1/x² = 5 − 2 = 3।","id":"q62c03539e1","t":"l","s":""},{"q":"যদি 4 (a - b) = 64 এবং 4 (a + b) = 1024 হলে, b এর মান কত?","o":["5","3","1","4"],"a":2,"e":"","id":"q62d392b381","t":"l","s":""},{"q":"x = 2 + √3 হলে, x 2 + 1/x 2 = ?","o":["12","14","6","7"],"a":1,"e":"","id":"q6446b67aab","t":"l","s":""},{"q":"x + y = 9 এবং xy = 20 হলে, x 3 + y 3 এর মান কত?","o":["189","174","215","98"],"a":0,"e":"","id":"q647b2cd824","t":"l","s":""},{"q":"যদি a + b + c = 0 হয়, তবে (a 3 + b 3 + c 3 ) 2 = কত?","o":["0","9abc","3a 2 b 2 c 2","9a 2 b 2 c 2"],"a":3,"e":"","id":"q64b78d1a83","t":"l","s":""},{"q":"p - 1/p = 5 হলে p 3 - 1/p 3 = কত?","o":["140","110","125","130"],"a":0,"e":"","id":"q64ef1dc513","t":"l","s":""},{"q":"log a (b 4 ) = 2x এবং log b (a 2 ) = 3y হলে, xy = কত?","o":["2/3","3/8","1","4/3"],"a":3,"e":"","id":"q65410b183d","t":"l","s":""}]
