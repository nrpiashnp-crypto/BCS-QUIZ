[{"q":"x + 1/x = 2 হলে x 47 + 1/x 47 এর মান কত?","o":["1","- 1","47","2"],"a":3,"e":"","id":"q25dd3dbadf","t":"l","s":""},{"q":"x = √3 + √2 হলে, x 3 - (1/x 3 ) এর মান কত?","o":["22√2","18√3","18√2","22√3"],"a":0,"e":"","id":"q25e7403a29","t":"l","s":""},{"q":"a = √3 - √2 হলে, a 3 + 3a + 3a - 1 + a - 3 এর মান কত?","o":["12√3","16√3","24√3","18√3"],"a":2,"e":"<p>রাশিটি আসলে a³ + ৩a + ৩a⁻¹ + a⁻³, যা (a + ১/a)³-এর বিস্তৃত রূপ।<br>(a + ১/a)³ = a³ + ৩a + ৩/a + ১/a³<br>a = √৩ − √২<br>১/a = ১/(√৩ − √২) = (√৩ + √২)/(৩ − ২) = √৩ + √২<br>a + ১/a = ২√৩<br>(২√৩)³ = ৮ × ৩√৩ = ২৪√৩<br>এখানে হরকে মূলদ্বারকমুক্ত করতে অনুবন্ধী (√৩ + √২) দিয়ে গুণ করা হয়েছে। ১২√৩ বা ১৮√৩ আসে (২√৩)³ ভুলভাবে কষলে, কারণ ২³ = ৮ এবং (√৩)³ = ৩√৩। একই প্রশ্নে a² + ১/a² চাইলে উত্তর হতো (২√৩)² − ২ = ১০।</p>","id":"q264924541f","t":"l","s":""},{"q":"(x 2 /y 2 ) + 2(x/y) এর সাথে কত যোগ করলে সংখ্যাটি পূর্ণ বর্গ হবে?","o":["1/xy","xy","x/y","1"],"a":3,"e":"","id":"q268baad41e","t":"l","s":""},{"q":"a + b = 8 এবং a - b = 2 হলে (a, b) এর মান কত?","o":["6, 2","6, 4","4, 4","5, 3"],"a":3,"e":"","id":"q2699672ebc","t":"l","s":""},{"q":"A = {x : x 2 - 5x + 6 = 0} এবং B = {x : x 2 - 11x + 24 = 0} হয় তবে (A - B) এর মান কত?","o":["{8}","{2}","{2, 3}","{3, 8}"],"a":1,"e":"","id":"q26b22588f6","t":"l","s":""},{"q":"x 4 + 2x 2 + 1 = 5x 2 হলে √5 (x + 1/x) = কত?","o":["25","5","1","√5"],"a":1,"e":"","id":"q27450ad2f4","t":"l","s":""},{"q":"2a + (2/a) = 8 হলে, a 2 + (1/a 2 ) এর মান কত?","o":["20","10","14","12"],"a":2,"e":"","id":"q2747358f50","t":"l","s":""},{"q":"x 4 - 3x 2 + 1 = 0 এবং x > 0 হলে, x 3 + (1/x 3 ) এর মান কত?","o":["5√2","3√5","2√5","4 √5"],"a":2,"e":"","id":"q279c213e1e","t":"l","s":""},{"q":"a - 1/a = 4 হলে a² + 1/a² = কত?","o":["18","14","16","22"],"a":0,"e":"","id":"q27c7bebc2b","t":"l","s":""},{"q":"(x/2) a + 3 = 1 হলে a-এর মান কত?","o":["- 2","3","- 3","2"],"a":2,"e":"","id":"q27eb4b6fba","t":"l","s":""},{"q":"If a 3 - b 3 = 56 and a - b = 2, then the value of a 2 + b 2 will be?","o":["27","23","20","15"],"a":2,"e":"(a - b)³ = a³ - b³ - 3ab(a - b) সূত্রে 8 = 56 - 6ab, তাই ab = 8। (a - b)² = 4 থেকে a² + b² = 4 + 2ab = 4 + 16 = 20।","id":"q2800ff36ad","t":"l","s":""},{"q":"4x 2 + (1/x 2 ) = 2 হলে, 8x 3 + (1/x 3 ) এর মান কত?","o":["0","2","3","1"],"a":0,"e":"","id":"q28130bbac6","t":"l","s":""},{"q":"x + (1/x) = 2 হলে, x 5 + (1/x 5 ) = কত?","o":["27","2","64","4"],"a":1,"e":"","id":"q283a23cd0b","t":"l","s":""},{"q":"a² − b² = 45 এবং a + b = 9 হলে, a − b এর মান কত?","o":["4","5","9","36"],"a":1,"e":"বর্গের অন্তরের সূত্র অনুযায়ী a² − b² = (a + b)(a − b)। তাই 45 = 9 × (a − b), অর্থাৎ a − b = 45 ÷ 9 = 5। অনেকে 45 − 9 = 36 লিখে ফেলে, অথচ এখানে গুণ ও ভাগের সম্পর্ক কাজ করছে।\nচাইলে a = 7, b = 2 বসিয়ে মিলিয়ে নিতে পারি। তখন a + b = 9, a − b = 5 এবং 49 − 4 = 45।\nমনে রাখুন:\na² − b² = (a + b)(a − b)\nদুটি সংখ্যার যোগফল ও বর্গের অন্তর জানা থাকলে অন্তর = বর্গের অন্তর ÷ যোগফল।","id":"q2866a59074","t":"l","s":""},{"q":"যদি a - (1/a) = 2 হয়, তবে a 4 + (1/a 4 ) এর মান কত?","o":["34","32","40","36"],"a":0,"e":"","id":"q2876cda91c","t":"l","s":""},{"q":"যদি a + b = 9 এবং ab = 20 হয়, তবে (a - b) 2 = কত?","o":["1","7","18","3"],"a":0,"e":"","id":"q289b3a3e64","t":"l","s":""},{"q":"2x + (2/x) = 3 হলে, x 3 + (1/x 3 ) + 3 এর মান কত?","o":["15/8","8/15","-8/9","-9/8"],"a":0,"e":"","id":"q28adf4f99b","t":"l","s":""},{"q":"1/(x 2 - 1) + 1/(x 4 - 1) + 4/(x 8 - 1) = কত?","o":["(x 8 +1)/(x 8 - 1)","(x 4 + 1)/(x 8 - 1)","(x 6 + 2x 4 + x 2 + 6)/(x 8 - 1)","1"],"a":2,"e":"","id":"q28c28c7895","t":"l","s":""},{"q":"যদি x 4 - x 2 + 1= 0 হয়, তবে x 3 + (1/x 3 ) =?","o":["0","3√3","6√3","1"],"a":0,"e":"","id":"q28e08e4f53","t":"l","s":""}]
