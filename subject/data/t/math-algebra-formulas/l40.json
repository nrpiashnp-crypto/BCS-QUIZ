""},{"q":"a - b = c হলে, a 3 - b 3 - c 3 = কত?","o":["1/abc","1/3abc","3abc","3ab/c"],"a":2,"e":"","id":"qb04298575b","t":"l","s":""},{"q":"{x 3 + y 3 + 3xy(x + y)}/(a + b) 3 , {a 3 + b 3 + 3ab(a + b)}/(x 2 - y 2 ) , (x - y) 2 /(x + y) 2 এর গুণফল কত?","o":["x + y","(x + y)/(x - y)","1","x - y"],"a":3,"e":"","id":"qb0c93ed857","t":"l","s":""},{"q":"x(3 - 2/x) = 3/x , then the value of x² +1/x² = ?","o":["3(1/9)","2(4/9)","3(4/9)","2(1/9)"],"a":1,"e":"","id":"qb14db4bb9d","t":"l","s":""},{"q":"a = 1, b = -1, c = 2, d = -2 হলে a - (-b) - (-c) - (-d) এর মান কত?","o":["0","2","3","1"],"a":0,"e":"","id":"qb175d56ca5","t":"l","s":""},{"q":"x + 1/x = 2 হলে x 4 + 1/x 4 এর মান কত?","o":["1","2","1/2","0"],"a":1,"e":"","id":"qb1debd712e","t":"l","s":""},{"q":"If x = (√3 + 1)/(√3 - 1) and y =(√3 - 1)/ (√3 + 1), then the value of x 2 + y 2 is?","o":["12√3","21","14","7√3"],"a":2,"e":"x = (√3 + 1)/(√3 − 1) আর y = (√3 − 1)/(√3 + 1) পরস্পরের উল্টা, তাই xy = 1। যোগফল x + y = [(√3 + 1)² + (√3 − 1)²]/2 = (4 + 2√3 + 4 − 2√3)/2 = 4। অতএব x² + y² = (x + y)² − 2xy = 16 − 2 = 14।","id":"qb1f15dc0ae","t":"l","s":""},{"q":"যদি (2 + √3)a = 1, এবং (2 - √3)b = 1 হলে এর মান কত?","o":["2","4","3√2","6"],"a":1,"e":"","id":"qb2ed1fc7b2","t":"l","s":""}]
