 করে x + 1/x = √6। বর্গ করলে x² + 2 + 1/x² = 6। তাই x² + 1/x² = 6 - 2 = 4।","id":"q9d337dc5b9","t":"l","s":""},{"q":"{(4.2 × 4.2) - (1.9 × 1.9)}/(2.3 × 6.1) = কত?","o":["1.0","2.3","4.2","8.4"],"a":0,"e":"","id":"q9d7dfccedb","t":"l","s":""},{"q":"x 2 + y 2 = 34 এবং xy = 15 হলে, (x, y) = ?","o":["(15, 1)","(3, 5)","(3, 6)","(1, 15)"],"a":1,"e":"","id":"q9d893c7369","t":"l","s":""},{"q":"a 3 + b 3 , (a + b) 3 , (a 2 - b 2 ) এবং (a 2 − ab + b 2 ) 2 এর গ.সা.গু কত?","o":["a 6 - b 6","1","(a + b) 3","a 3 + b 3"],"a":1,"e":"","id":"q9e813843cf","t":"l","s":""},{"q":"2ab-a 2 -b 2 +c 2 এর একটি উৎপাদক -","o":["a+b+c","b-c+a","b+c-a","a+b-c"],"a":2,"e":"","id":"q9e8c0a59b4","t":"l","s":""},{"q":"ab + bc + ca = 8 এবং a 2 + b 2 + c 2 = 9 হলে, a + b + c = কত?","o":["4","6","0","5"],"a":3,"e":"","id":"q9ea36e8aed","t":"l","s":""},{"q":"x/y - y/x = 3 হলে, x 2 /y 2 + y 2 /x 2 এর মান কত?","o":["0","7","9","11"],"a":3,"e":"","id":"q9f188a8861","t":"l","s":""},{"q":"1/(x + 1) এর মান নিচের কোনটি হওয়া অসম্ভব?","o":["2/3","0","1","-1"],"a":1,"e":"","id":"q9fcf58705b","t":"l","s":""}]
