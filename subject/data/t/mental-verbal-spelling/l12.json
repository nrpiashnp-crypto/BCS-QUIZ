[{"q":"সঠিক বানানটি কোনটি?","o":["মধ্যাহ্ণ","প্রতিযোগীতা","গুণীজন","ভৌগোলিক"],"a":3,"e":"","id":"qe4f2651ea9","t":"l","s":""},{"q":"অশুদ্ধ বানান -","o":["ক্রীড়া","ঐকতান","আশীষ","উত্তরণ"],"a":2,"e":"","id":"qe517498d15","t":"l","s":""},{"q":"নিচের শব্দটির প্রতিশব্দ নির্ণয় করুন। অভ্র:","o":["সাদা","ভ্রমর","মেঘ","পাহাড়","কোনোটিই নয়"],"a":2,"e":"<p>‘অভ্র’ শব্দের অর্থ মেঘ, তাই এটি মেঘের প্রতিশব্দ। অভ্র দিয়ে আকাশও বোঝায়, আর ভিন্ন অর্থে একটি স্বচ্ছ পাতলা খনিজ পদার্থকেও অভ্র (mica) বলে। মেঘের অন্য প্রতিশব্দ জলদ, জলধর, বারিদ, নীরদ, পয়োদ, অম্বুদ, ঘন। ভ্রমরের প্রতিশব্দ অলি, মধুকর, ষটপদ, আর পাহাড়ের প্রতিশব্দ গিরি, অচল, অদ্রি, ভূধর। ‘অভ্র’ ও ‘ভ্রমর’ দেখতে কাছাকাছি হওয়ায় ফাঁদ তৈরি হয়েছে, কিন্তু অর্থে কোনো মিল নেই। ‘অভ্রংলিহ’ মানে আকাশছোঁয়া বা অতি উঁচু, এটিও অভ্র থেকে গঠিত ও পরীক্ষায় আসে।</p>","id":"qe54c022476","t":"l","s":""},{"q":"সঠিক বানান কোনটি?","o":["Seperate","Recieve","Occassion","Embarrassment"],"a":3,"e":"","id":"qe82ab4f8de","t":"l","s":""},{"q":"নিচের কোন বাক্যটি শুদ্ধ?","o":["বৃক্ষটি সমূলসহ উৎপাঠিত হয়েছে।","গীতাঞ্জলী প্রখ্যাত কাব্য।","দীনতা সব সময় প্রশংসনীয় নহে।","বিপদগ্রন্থকে সাহায্য কর।"],"a":2,"e":"","id":"qe8308ec6f2","t":"l","s":""},{"q":"'শিক্ষক' শব্দের শুদ্ধ উচ্চারণ হচ্ছে -","o":["শিক্‌ষক্‌","শিক্‌খক্‌","শিক্‌ক্ষক্‌","শিকখ্‌ক"],"a":1,"e":"","id":"qea4e678765","t":"l","s":""},{"q":"নিচের শব্দটির প্রতিশব্দ নির্ণয় করুন। কুজ্ঝটিকা:","o":["কুয়াশা","অনুকার","প্রভাকর","শৈল","কোনোটিই নয়"],"a":0,"e":"<p>'কুজ্ঝটিকা' শব্দের অর্থ কুয়াশা, তাই এটিই এর প্রতিশব্দ। শীতকালের ভোরে বায়ুর জলীয় বাষ্প ঘনীভূত হয়ে যে অস্বচ্ছ আবরণ তৈরি করে, সেটিকেই কুজ্ঝটিকা বা কুহেলিকা বলা হয়। 'অনুকার' মানে অনুকরণ, 'প্রভাকর' মানে সূর্য, আর 'শৈল' মানে পাহাড়—কোনোটিই কুয়াশার সমার্থক নয়। কুয়াশার আরও কয়েকটি প্রতিশব্দ কুহেলি, কুহেলিকা ও নীহার, যা পরীক্ষায় প্রায়ই আসে।</p>","id":"qead95ca373","t":"l","s":""},{"q":"নিচের কোন বানানটি শুদ্ধ?","o":["তদ্ধিত","তদ্বিত","তদ্বিৎ","তদ্ধিৎ"],"a":0,"e":"","id":"qedfc74464c","t":"l","s":""},{"q":"'চপল' -এর বিপরীতার্থক শব্দ কোনটি?","o":["অচল","অচেনা","অচপল","অচ্যুত"],"a":2,"e":"","id":"qf0866a382a","t":"l","s":""},{"q":"নিচের কোন বানানটি অশুদ্ধ?","o":["মনীষী","কৌতুহল","সমীচীন","উচ্ছ্বাস"],"a":1,"e":"","id":"qf0aa52ac11","t":"l","s":""},{"q":"নিচের কোনটি প্রত্যয়ের অপপ্রয়োগজনিত অশুদ্ধ?","o":["চঞ্চলতা","অলসতা","কার্পন্যতা","অধীরতা"],"a":2,"e":"","id":"qf1859a29c1","t":"l","s":""},{"q":"নিচের কোন শব্দটি 'সংকাশ' শব্দের সমার্থক?","o":["সংহার","নিকটস্থ","সমর্পণ","প্রলয়"],"a":1,"e":"","id":"qf2792558a0","t":"l","s":""},{"q":"কোন বানানটি শুদ্ধরূপে লেখা?","o":["প্রতিদ্বন্দ্বিতা","প্রতিদ্বন্দীতা","প্রতিদন্দ্বিতা","প্রতিদ্বন্দিতা"],"a":0,"e":"","id":"qf3b128cfb7","t":"l","s":""},{"q":"কোনটি অপপ্রয়োগ?","o":["সুস্বাগত","যদ্যপি","আরক্ত","বিবিধ"],"a":0,"e":"","id":"qf3cd9cb521","t":"l","s":""},{"q":"'চাঁদ' এর সমার্থক শব্দ নয় কোনটি?","o":["হিমাংশু","শশধর","নিশাকর","অদ্রি"],"a":3,"e":"","id":"qf3d679dd7c","t":"l","s":""},{"q":"কোন গুচ্ছের সবগুলো বানানই শুদ্ধ?","o":["সান্তনা, মনস্তাপ, দারিদ্র্য","সান্ত্বনা, প্রতিযোগিতা, শশ্রূষা","শুশ্রূষা, মনস্তাপ, স্বায়ত্তশাসন","স্বায়ত্বশাসন, দারিদ্র্য, প্রতিযোগিতা"],"a":2,"e":"","id":"qf4ed8f681d","t":"l","s":""},{"q":"সঠিক সমার্থক শব্দ জোড়া কোনটি?","o":["লহর, গজ","মৃগ, মৃগাঙ্ক","বিহগ, দ্বিজ","অরুণ, পাষাণ"],"a":2,"e":"","id":"qf74cdd9c10","t":"l","s":""},{"q":"'যিনি প্রথমে পথ দেখান' এক কথায় কী বলে?","o":["পথিকৃৎ","পথিক","পথপাদপ","পথপ্রদশক"],"a":0,"e":"","id":"qf83b364403","t":"l","s":""},{"q":"নিচের কোন শব্দের প্রয়োগ শুদ্ধ?","o":["সৌন্দর্য","সারল্যতা","অধীনস্থ","শ্রেষ্ঠতর"],"a":0,"e":"","id":"qf9dc321cf3","t":"l","s":""},{"q":"সঠিক সমার্থক শব্দ জোড়া কোনটি?","o":["মৃগ, মৃগাঙ্ক","কুমুদ, কৌমুদী","নগ, নাগ","ক্ষণদা, ত্রিযামা"],"a":3,"e":"","id":"qfa14bb2d4f","t":"l","s":""},{"q":"শুদ্ধ বানানগুচ্ছ-","o":["বিভীষিকা, আশীর্বাদ","পূর্বাহ্ন, অভিষেক","নির্ণিমেষ, অপরাহ্ন","প্রত্যূষ, নূপুর"],"a":0,"e":"","id":"qfa63e02e22","t":"l","s":""},{"q":"সন্ধি বিষয়ক অপপ্রয়োগ কোনটি?","o":["তরুছায়া","মুখচ্ছবি","দুরবস্থা","দুরাদৃষ্ট"],"a":3,"e":"","id":"qfc037ef234","t":"l","s":""},{"q":"পূর্ব জন্মের কথা স্মরণ আছে?","o":["শাস্ত্রজ্ঞ","পূর্বসূরী","জাতিস্মর","ক্ষণজন্মা"],"a":2,"e":"<p>পূর্বজন্মের কথা যার স্মরণে আছে, তাকে এক কথায় ‘জাতিস্মর’ বলে। এখানে ‘জাতি’ শব্দের অর্থ জন্ম, আর ‘স্মর’ মানে যে স্মরণ করে। ‘শাস্ত্রজ্ঞ’ মানে যিনি শাস্ত্র জানেন। ‘পূর্বসূরি’ মানে আগের কালের ব্যক্তি বা পূর্বপুরুষ, যিনি আগে কোনো পদে বা কাজে ছিলেন। ‘ক্ষণজন্মা’ মানে শুভক্ষণে জন্মেছেন এমন অসাধারণ ব্যক্তি। এক কথায় প্রকাশের আরও উদাহরণ: যা পূর্বে কখনো দেখা যায়নি — অদৃষ্টপূর্ব, যা কষ্টে লাভ করা যায় — দুর্লভ।</p>","id":"qfd22cbb301","t":"l","s":""},{"q":"নিচের কোন বিপরীত শব্দজোড়টি সঠিক নয়?","o":["মৌন - মুখর","সওয়াল - প্রশ্ন","হক - নাহক","স্বমত - পরমত"],"a":1,"e":"","id":"qfe13eb6032","t":"l","s":""},{"q":"'চিনে জোঁক' বাগধারাটির অর্থ কী?","o":["স্বার্থপর ব্যক্তি","অত্যন্ত লোভী লোক","বিষাক্ত প্রাণী","নাছোড়বান্দা ব্যক্তি"],"a":3,"e":"","id":"qfeb88d371a","t":"l","s":""},{"q":"কোন বাক্যে শুদ্ধ প্রয়োগ ঘটেছে?","o":["তাহার একটুও সাবকাশ নাই","তিনি আরোগ্য হইয়াছেন","গোপন কথাটি শুন","অপমানিত হইবার ভয় নাই"],"a":3,"e":"","id":"qff1c383c28","t":"l","s":""},{"q":"‘শুচি ও সূচি’ শব্দজোড়টি কী অর্থ প্রকাশ করে?","o":["বিবরণী ও পবিত্র","পবিত্র ও তালিকা","পরিচ্ছন্ন ও পবিত্র","সুন্দর ও তালিকা"],"a":1,"e":"","id":"qfff69d7c78","t":"l","s":""}]
