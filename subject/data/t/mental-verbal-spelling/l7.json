[{"q":"'শম্পা' শব্দটির অর্থ-","o":["বিদ্যুৎ","গাছ","মেঘ","বৃষ্টি"],"a":0,"e":"","id":"q63107855ff","t":"l","s":""},{"q":"'হাড় হাভাতে'- এর বাগ্‌ধারা কী?","o":["হতভাগ্য","অপচয়","কষ্ট পাওয়া","ভিক্ষে করা"],"a":0,"e":"<p>'হাড় হাভাতে' বাগ্‌ধারার অর্থ হতভাগ্য, অর্থাৎ অতি দরিদ্র ও দুর্ভাগা মানুষ। শব্দটির ভাব হলো, যে এতটা অভাবগ্রস্ত যে ভাতও জোটে না, ফলে তাকে তিরস্কার বা করুণার স্বরে এই নামে ডাকা হয়। অপচয়, কষ্ট পাওয়া বা ভিক্ষা করা এই বাগ্‌ধারার প্রচলিত অর্থ নয়। অপচয় অর্থে 'ভস্মে ঘি ঢালা', আর কষ্ট পাওয়া অর্থে 'হাড়ে হাড়ে টের পাওয়া' বাগ্‌ধারা ব্যবহৃত হয়। পরীক্ষায় প্রায়ই আসে হাড়-সংক্রান্ত আরও বাগ্‌ধারা: হাড় জুড়ানো (শান্তি পাওয়া), হাড়ভাঙা খাটুনি (কঠোর পরিশ্রম)।</p>","id":"q63745c0bdd","t":"l","s":""},{"q":"'হাতি' শব্দের সমার্থক শব্দ -","o":["দ্বিরদ","ঘোটক","তুরঙ্গ","বাজী"],"a":0,"e":"","id":"q65733ff395","t":"l","s":""},{"q":"নিচের কোনটিতে সন্ধি বিষয়ক অশুদ্ধি ঘটেছে?","o":["অহর্নিশ","নির্দোষ","নিরভিমান","অদ্যবধি"],"a":3,"e":"","id":"q6644dc9019","t":"l","s":""},{"q":"কোন বানানটি অশুদ্ধ?","o":["সন্ধিহান","সম্বল","সূচিপত্র","সন্ন্যাসী"],"a":0,"e":"","id":"q668cf42546","t":"l","s":""},{"q":"নিচের কোন বানানটি শুদ্ধ?","o":["ভস্মীভূত","কৃচ্ছসাধন","নিশিথীনি","পিপিলিকা"],"a":0,"e":"","id":"q66ad01f24d","t":"l","s":""},{"q":"'কেশ' এর সমার্থক শব্দ নয় কোনটি?","o":["কুন্তল","অসিত","অলক","কবরী"],"a":1,"e":"","id":"q67c360a5ee","t":"l","s":""},{"q":"'পর্বত' শব্দের সমার্থক শব্দ -","o":["রত্নাকর","অচল","বারিধি","তোয়নিধি"],"a":1,"e":"","id":"q68e86af1d1","t":"l","s":""},{"q":"নিচের কোন বানানটি অশুদ্ধ?","o":["স্বরস্বতী","লজ্জাকর","পিপীলিকা","অভ্যুত্থান"],"a":0,"e":"","id":"q6b46ec048c","t":"l","s":""},{"q":"নিচের কোন বানানটি অশুদ্ধ?","o":["মরীচিকা","বিভীষিকা","শিরচ্ছেদ","সান্ত্বনা"],"a":2,"e":"","id":"q6b73f0f2a8","t":"l","s":""},{"q":"'বৃক্ষ' এর সমার্থক শব্দ নয় কোনটি?","o":["তরু","কানন","শাখী","মহীরুহ"],"a":1,"e":"","id":"q6bbf0d7e77","t":"l","s":""},{"q":"প্রশ্নবোধক স্থানের যথার্থ চিত্রটি বাছাই করুন।","o":["1","3","4","2"],"a":1,"e":"","id":"q6cd3f33bbc","t":"l","s":""},{"