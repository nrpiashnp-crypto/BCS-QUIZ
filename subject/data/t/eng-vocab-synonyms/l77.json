[{"q":"Choose the synonym of Pretentious:","o":["Scarce","Humble","Fruitful","Ostentatious"],"a":3,"e":"","id":"q7fbf9f7a0c","t":"l","s":""},{"q":"The word 'Rabble' means-","o":["ভ্রমণের পরিকল্পনা","কাপুরুষ","উচ্ছৃঙ্খল জনতা","সোজা লম্বা দাগযুক্ত"],"a":2,"e":"","id":"q7fc5c4bc4c","t":"l","s":""},{"q":"Choose the synonym of 'Frugality'.","o":["Extravagance","Indulgence","Folly","Moderation"],"a":3,"e":"","id":"q7fd539263c","t":"l","s":""},{"q":"Which of the following is a correct synonym for “Daunt”?","o":["Encourage","Intimidate","Hearten","Embolden"],"a":1,"e":"","id":"q7fe9b36fa3","t":"l","s":""},{"q":"Synonym of 'Exacerbate' -","o":["Dilute","Calm","Abridge","Worsen"],"a":3,"e":"","id":"q7ff14d6cb3","t":"l","s":""},{"q":"Which of the following is the Synonym of 'Warrant'?","o":["Gentle","Disapproval","Permission","Criminal"],"a":2,"e":"","id":"q7ff5693f95","t":"l","s":""},{"q":"Which of these words is NOT a synonym of \"pedantic\"?","o":["Painstaking","Fraudulent","Formalist","Precise"],"a":1,"e":"","id":"q7ffe09bb1b","t":"l","s":""},{"q":"Choose the correct meaning of the word \"Plaudit\":","o":["Casual conversation","Harsh criticism","Disrespectful remark","Enthusiastic approval"],"a":3,"e":"","id":"q7ffe351e37","t":"l","s":""},{"q":"What is the synonym of \"Alleviate\"?","o":["Despise","Mitigate","Succumb","Aggravate"],"a":1,"e":"Alleviate verb, অর্থ যন্ত্রণা, কষ্ট বা সমস্যার তীব্রতা কমানো, অর্থাৎ লাঘব বা উপশম করা। Mitigate-এর অর্থও প্রচণ্ডতা বা বেদনা হ্রাস করা, তাই দুটি সমার্থক। উদাহরণ: Medicine can alleviate the pain। মনে রাখুন: Despise মানে ঘৃণা করা, Aggravate মানে পরিস্থিতি আরও গুরুতর করে তোলা, যা alleviate-এর বিপরীত, আর Succumb মানে বশ্যতা স্বীকার করা বা মৃত্যুবরণ করা।","id":"q802f39b045","t":"l","s":""},{"q":"It would be presumptuous of me to comment on the matter. Here, the underlined word \"presumptuous\" means-","o":["Shy","Arrogant","Unassuming","Deferential"],"a":1,"e":"","id":"q8041b1de35","t":"l","s":""},{"q":"বড়াইপূর্ণ-","o":["Submissive","Ostentatious","Unpretentious","Modest"],"a":1,"e":"","id":"q80475574e9","t":"l","s":""},{"q":"A synonym of 'preamble' is:","o":["Prelude","Epilogue","Distill","Felicitous"],"a":0,"e":"","id":"q80564fd1ba","t":"l","s":""},{"q":"The term 'Propel' is a/an -","o":["Adjective","Adverb","Verb","Noun"],"a":2,"e":"","id":"q8060c85cc8","t":"l","s":""},{"q":"Which word is synonymous with 'Ostentatious'?","o":["Restrained","Modest","Conspicuous","Natural"],"a":2,"e":"","id":"q8066d71aca","t":"l","s":""},{"q":"What does the word 'Hermetic' mean?","o":["Completely sealed","Open and accessible","Temporary and fleeting","Highly visible"],"a":0,"e":"","id":"q80696844ac","t":"l","s":""},{"q":"The word “Malleable” most nearly means-","o":["Difficult to bend or change","Easily broken into pieces","Impossible to change","Easily bent or shaped"],"a":3,"e":"","id":"q806df0255b","t":"l","s":""},{"q":"Choose the synonym of the word 'Quandary'.","o":["Perplexed","Unnoticed","Prominent","Certainty"],"a":0,"e":"","id":"q809e19f3a6","t":"l","s":""},{"q":"Identify the appropriate synonym of the word 'Doggerel'.","o":["Prose","Story","Poetry","Essay"],"a":2,"e":"","id":"q809fbb202e","t":"l","s":""},{"q":"The synonym of 'Paucity' -","o":["Plenty","Sufficiency","Dearth","Abundance"],"a":2,"e":"","id":"q80abdf1607","t":"l","s":""},{"q":"Choose a synonym for 'Disquieting'.","o":["Settling","Ending","Troubling","Soothing"],"a":2,"e":"Disquieting মানে অশান্তিকর বা উদ্বেগ জাগানো, যা মনের শান্তি নষ্ট করে। Troubling শব্দের অর্থও কষ্টদায়ক বা দুশ্চিন্তাজনক, তাই এটি সমার্থক। অন্য শব্দ: Ending মানে শেষ অংশ, Soothing মানে প্রশান্তিদায়ক বা শীতল করা, আর Settling মানে নিষ্পত্তি বা স্থির করা; soothing এখানে বিপরীত ভাব দেয়।","id":"q80ce5b0f88","t":"l","s":""}]
