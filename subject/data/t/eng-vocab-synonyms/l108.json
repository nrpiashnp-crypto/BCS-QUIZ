[{"q":"What is the synonym of the word 'Timid'?","o":["Sacred","Scared","Stout","Daring"],"a":1,"e":"","id":"qb813e0d3e7","t":"l","s":""},{"q":"Which one best refers to the bengali meaning of the word ‘Relegate’ -","o":["মিলিত হওয়া","অনিয়ত","পর্যবসিত করা","পদচারণা করা"],"a":2,"e":"","id":"qb8640cb1b7","t":"l","s":""},{"q":"The synonym of 'Obdurate' is -","o":["Vindictive","Deceitful","Stubborn","Disguise"],"a":2,"e":"","id":"qb876abd442","t":"l","s":""},{"q":"Find the odd one out-","o":["Insularity","Provincialism","Tolerance","Narrowness"],"a":2,"e":"","id":"qb87932a224","t":"l","s":""},{"q":"Choose the synonym of 'slovenly'.","o":["friendly","irritating","inattentive","solvent"],"a":2,"e":"slovenly মানে অগোছালো বা অসতর্ক আচরণের, এখানে সমার্থক inattentive (অমনোযোগী)। friendly মানে বন্ধুত্বপূর্ণ, irritating মানে বিরক্তিকর, আর solvent মানে স্বচ্ছল। slovenly dress মানে অগোছালো পোশাক। বিপরীত শব্দ neat বা tidy।","id":"qb8d7d411eb","t":"l","s":""},{"q":"What is the synonym for the word 'Divulge'?","o":["Conceal","Cloak","Leak","Camouflage"],"a":2,"e":"","id":"qb8e125c360","t":"l","s":""},{"q":"The synonym of the word \"Belligerent\" is -","o":["Peaceful","Aggressive","Calm","Friendly"],"a":1,"e":"","id":"qb922e505a3","t":"l","s":""},{"q":"The synonym of 'False' is-","o":["Sparse","Surge","Spurious","Inlet"],"a":2,"e":"","id":"qb937a92477","t":"l","s":""},{"q":"The synonym of 'jovial' is —","o":["cheerful","gloomy","furious","timid"],"a":0,"e":"Jovial মানে হাসিখুশি ও আমুদে স্বভাবের, অর্থাৎ cheerful। Gloomy মানে বিষণ্ণ, furious মানে ক্রুদ্ধ এবং timid মানে ভীরু। শব্দটি রোমান দেবতা Jove বা Jupiter থেকে এসেছে বলে ধরা হয়।\nমনে রাখুন:\njovial = cheerful = merry = genial","id":"qb96ce85d3a","t":"l","s":""},{"q":"The word 'Breach' means -","o":["To prevent something from happening by acting first","Completely without harm","Strongly critical","An act of breaking a law"],"a":3,"e":"","id":"qb97fd63e5a","t":"l","s":""},{"q":"Give the synonym of the word 'epitomize’.","o":["Broaden","Effeminate","Encapsulate","Elaborate"],"a":2,"e":"","id":"qb9833253ad","t":"l","s":""},{"q":"What is the meaning of the word \"Pristine\"?","o":["Brave and courageous","Clear and straightforward","Fresh and clean as new","Weak or ineffective"],"a":2,"e":"","id":"qb9861d0c3f","t":"l","s":""},{"q":"Choose the synonym of the word 'Bucolic'.","o":["Metropolis","Civic","Agrarian","Urban"],"a":2,"e":"","id":"qb986644104","t":"l","s":""},{"q":"Choose the correct synonym of 'Confusion'-","o":["Transposition","Tangle","Stream","Diffusion"],"a":1,"e":"","id":"qb98dd73a6d","t":"l","s":""},{"q":"The synonym of ‘Lethargy’ is -","o":["Timidity","Exhaustion","Suffocation","Boredom"],"a":1,"e":"","id":"qb9a7074973","t":"l","s":""},{"q":"Which term aligns best with the concept of \"Egalitarian\"?","o":["Oligarchic","Classless","Totalitarian","Meritocratic"],"a":1,"e":"","id":"qb9acdbbbcc","t":"l","s":""},{"q":"What is the synonym of the word \"Rarefied\"?","o":["Obvious","Esoteric","Unmysterious","Exoteric"],"a":1,"e":"","id":"qb9ca7d2cc4","t":"l","s":""},{"q":"The word \"Infectious' is -","o":["Noun","Verb","Adverb","Adjective"],"a":3,"e":"","id":"qb9ce60f788","t":"l","s":""},{"q":"What is the synonym of 'Apex'?","o":["Base","Minimum","Pinnacle","Nadir"],"a":2,"e":"","id":"qb9f08f7a7a","t":"l","s":""},{"q":"What does the word \"Wrangle\" mean?","o":["To peacefully agree on something","To engage in a long and complicated argument or dispute","To help someone with a task","To express excitement or joy"],"a":1,"e":"","id":"qba07e39c85","t":"l","s":""}]
