[{"q":"'হরণ'র বিপরীতার্থক শব্দ কোনটি?","o":["র্ভীক","অপহরণ","পূরণ","ভীরু"],"a":2,"e":"","id":"q969f7fcb98","t":"l","s":""},{"q":"‘অপ্রতিভ’ শব্দটির বিপরীত শব্দ কোনটি?","o":["প্রকৃষ্ট","প্রতিভ","প্রভাত","সপ্রতিভ"],"a":3,"e":"সঠিক উত্তর সপ্রতিভ। 'অপ্রতিভ' মানে লজ্জিত বা হতভম্ব, আর এর উল্টো সপ্রতিভ, অর্থাৎ বুদ্ধিমান, চটপটে, লজ্জাহীন সাবলীল। বিকল্পের 'প্রতিভ' শব্দটি সরাসরি বিপরীত নয়। আরও কিছু বিপরীত জোড়া: প্রকৃষ্ট-নিকৃষ্ট, প্রভাত-সন্ধ্যা, ধৃষ্ট-নম্র, নশ্বর-শাশ্বত।","id":"q9a21ded360","t":"l","s":""},{"q":"'রুষ্ট' এর বিপরীত শব্দ কী?","o":["যথেষ্ট","শান্ত","পূর্ণ","তুষ্ট"],"a":3,"e":"","id":"q9aefc65e28","t":"l","s":""},{"q":"'বন্ধুর' বিপরীত শব্দ কোনটি?","o":["শত্রু","বন্ধু","মসৃণ","কণ্টক"],"a":2,"e":"","id":"q9feac74a29","t":"l","s":""},{"q":"'বিজন' শব্দের বিপরীত শব্দ-","o":["সমভূমি","লোকালয়","মরুভূমি","জলাশয়"],"a":1,"e":"","id":"qabf9e79e6f","t":"l","s":""},{"q":"'অধমর্ণ' শব্দের বিপরীত শব্দ কোনটি?","o":["ঋণী","দেনাদার","উত্তমর্ণ","ঋণগ্রহীতা"],"a":2,"e":"ঋণ বা ধার যে নেয়, তাকে অধমর্ণ বলে, আর যে ঋণ দেয়, সে উত্তমর্ণ। তাই অধমর্ণের বিপরীত শব্দ উত্তমর্ণ। ঋণী, দেনাদার ও ঋণগ্রহীতা তিনটিই অধমর্ণের সমার্থক, বিপরীত নয়।\nমনে রাখুন:\nঅধমর্ণ = ঋণগ্রহীতা\nউত্তমর্ণ = ঋণদাতা, মহাজন","id":"qaefb1ca481","t":"l","s":""},{"q":"উৎকর্ষ : অপকর্ষ : : অনুরক্ত : ?","o":["বিরত","উগ্র","বিনয়","বিরক্ত"],"a":3,"e":"","id":"qaf2a832908","t":"l","s":""},{"q":"'চেতন' শব্দের বিপরীত শব্দ-","o":["অনাচেতন","অবচেতনা","অচেতন","সজ্ঞান"],"a":2,"e":"","id":"qb156d5a07d","t":"l","s":""},{"q":"'সুশ্রী' শব্দের বিপরীত শব্দ কোনটি?","o":["শ্রীযুক্ত","অমৃত","বিশ্রী","সুদর্শন"],"a":2,"e":"","id":"qb3bc7b6c02","t":"l","s":""},{"q":"'বিজিত' শব্দের বিপরীত শব্দ নিচের কোনটি?","o":["বিজেতা","লাঘব","বৃদ্ধি","নিয়ত","কোনোটিই নয়"],"a":0,"e":"","id":"qbf210948bf","t":"l","s":""},{"q":"‘উৎকণ্ঠা' শব্দের বিপরীত শব্দ হলো-","o":["শান্তি","আবেগ","অপকণ্ঠা","উৎকণ্ঠিত"],"a":0,"e":"","id":"qbf5f65d3d6","t":"l","s":""},{"q":"'অপসৃয়মান' শব্দের বিপরীত শব্দ কোনটি?","o":["উদীয়মান","বিবর্তমান","ক্ষীয়মাণ","বিলীয়মান"],"a":0,"e":"","id":"qc16d1878f7","t":"l","s":""},{"q":"’তোয়াজ’ শব্দের বিপরীত শব্দ কোনটি?","o":["অন্দর","তাচ্ছিল্য","জীবিত","স্বাতন্ত্র্য"],"a":1,"e":"","id":"qc1f54f4fd6","t":"l","s":""},{"q":"'কৃপণ' শব্দের বিপরীত শব্দ কোনটি?","o":["কঞ্জুস","বদান্য","নিষ্ঠুর","অলস"],"a":1,"e":"যে খরচ করতে চায় না বা দান করতে চায় না, তাকে কৃপণ বলে। এর বিপরীত হলো বদান্য, অর্থাৎ যে মুক্তহস্তে দান করে। কঞ্জুস আসলে কৃপণেরই আরেক নাম, তাই সেটি সমার্থক শব্দ, বিপরীত নয়।\nমনে রাখুন:\nকৃপণ ↔ বদান্য, দানশীল, উদার\nকৃপণ = কঞ্জুস, কৃপণ, সংকীর্ণচিত্ত","id":"qc525e3e8a4","t":"l","s":""},{"q":"'প্রবল' শব্দটির বিপরীতার্থক শব্দ কোনটি?","o":["মূখ্য","লঘু","গৌণ","মৃদু"],"a":3,"e":"","id":"qc6c2be59c8","t":"l","s":""},{"q":"'অপসৃয়মান' এর বিপরীত শব্দ কোনটি?","o":["ক্ষীয়মাণ","উদীয়মান","বিলীয়মান","ক্ষয়মান"],"a":1,"e":"","id":"qcc280b2255","t":"l","s":""},{"q":"‘উত্তরণ’ এর বিপরীত শব্দ কোনটি?","o":["অবতরণ","আবাহন","আরোহণ","চিরন্তন"],"a":0,"e":"সঠিক উত্তর অবতরণ। 'উত্তরণ' মানে ওপরে ওঠা বা পার হয়ে যাওয়া, তার বিপরীতে নিচে নামা, অর্থাৎ অবতরণ। বাকি বিকল্পগুলোর বিপরীত আলাদা: আবাহনের বিপরীত বিসর্জন, চিরন্তনের বিপরীত আকস্মিক। 'আরোহণ'-ও উত্তরণের কাছাকাছি অর্থ দেয় (ওঠা), তাই সেটি বিপরীত হতে পারে না।","id":"qe37f0bdb33","t":"l","s":""},{"q":"'হৃদ্য' শব্দের বিপরীত শব্দ কোনটি?","o":["রুচ্য","অহৃদ্য","বিরক্ত","কপট"],"a":3,"e":"","id":"qe46b75f5b5","t":"l","s":""},{"q":"'অনুগ্রহ' শব্দের বিপরীত শব্দ কোনটি?","o":["আগ্রহ","নিগ্রহ","বিগ্রহ","পরিগ্রহ"],"a":1,"e":"অনুগ্রহ মানে দয়া বা কৃপা করা। এর বিপরীত হলো নিগ্রহ, অর্থাৎ শাস্তি দেওয়া বা পীড়ন করা। 'গ্রহ' অংশ একই রেখে উপসর্গ বদলে গেছে বলে অপশনগুলো একই রকম দেখায়, কিন্তু আগ্রহ মানে ইচ্ছা, বিগ্রহ মানে যুদ্ধ বা মূর্তি, আর পরিগ্রহ মানে গ্রহণ।\nমনে রাখুন:\nঅনুগ্রহ ↔ নিগ্রহ\nসৃষ্টি ↔ ধ্বংস","id":"qecb09f8d26","t":"l","s":""},{"q":"লেশ : যথেষ্ঠ :: ভূত : ?","o":["বিনীত","নির্লিপ্ত","ভবিষৎ","কপটতা"],"a":2,"e":"","id":"qf6cf518b68","t":"l","s":""},{"q":"আবাহন শব্দের বিপরীত শব্দ কোনটি?","o":["উত্তরণ","নির্গমন","বিসর্জন","অবরোহণ","কোনটিই নয়"],"a":2,"e":"","id":"qf91f6bcd22","t":"l","s":""},{"q":"‘আরোহন’ শব্দটির বিপরীতার্থক শব্দটি-","o":["বিসর্জন","গমন","নিন্মগমন","অবরোহন"],"a":3,"e":"","id":"qfaeb8a4340","t":"l","s":""},{"q":"‘আরোহণ’ এর বিপরীতার্থক শব্দ কি?","o":["বিসর্জন","অবরোহণ","বহির্গমন","সংশ্লেষন"],"a":1,"e":"","id":"qff97a900d0","t":"l","s":""}]
