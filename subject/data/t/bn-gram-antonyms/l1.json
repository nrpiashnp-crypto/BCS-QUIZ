[{"q":"'গৃহী' এর বিপরীত শব্দ কোনটি?","o":["সন্ন্যাসী","যাযাবর","বিবাগী","ঘরহীন"],"a":0,"e":"","id":"qa8d4f46e57","t":"l","s":""},{"q":"'আকুঞ্চন’ এর বিপরীত শব্দ -","o":["উত্তরণ","প্রত্যাগমন","প্রসারণ","বিসর্জন"],"a":2,"e":"সঠিক উত্তর প্রসারণ। 'আকুঞ্চন' মানে গুটিয়ে আসা বা সংকোচন, তার উল্টো হলো ছড়িয়ে যাওয়া, অর্থাৎ প্রসারণ। অন্য বিকল্পগুলো আকুঞ্চনের নয়, অন্য শব্দের বিপরীত: উত্তরণ-অবতরণ, প্রত্যাগমন-প্রস্থান, বিসর্জন-আবাহন। আকুঞ্চন ও প্রসারণ শব্দ দুটি শারীরবিজ্ঞানেও পেশির সংকোচন-প্রসারণ বোঝাতে লাগে।","id":"qd45cac72bd","t":"l","s":""},{"q":"'গৃহী' শব্দের বিপরীত শব্দ কোনটি?","o":["সন্যাসী","সন্মাসী","সন্ন্যাসী","সন্নাসী"],"a":2,"e":"","id":"qdc93d9881f","t":"l","s":""},{"q":"'আবাহন' এর বিপরীতার্থক শব্দ কোনটি?","o":["বিসর্জন","তিরোভাব","বিলম্ব","সম্মতি"],"a":0,"e":"","id":"q1e7d9f5a7c","t":"l","s":""},{"q":"'মোক্ষ' এর বিপরীত শব্দ কোনটি?","o":["বন্ধন","মূখ্য","মুখর","মুক্ত"],"a":0,"e":"","id":"q3d92dd1db0","t":"l","s":""},{"q":"নিচের কোন বিপরীত শব্দজোড় শুদ্ধ নয়?","o":["উত্তর - দক্ষিণ","উত্তম - মধ্যম","ঊর্ধ্ব - আধঃ","উত্থান - পতন"],"a":1,"e":"","id":"q52079220aa","t":"l","s":""},{"q":"'তাতা' শব্দের বিপরীত শব্দ কোনটি?","o":["গরম","ঠাণ্ডা","ত্বরা","তন্দ্রা"],"a":1,"e":"","id":"q5d62687eb5","t":"l","s":""},{"q":"'পামর' এর বিপরীত শব্দ কোনটি?","o":["পুণ্যবান","দয়ালু","পাষাণ","নীচ"],"a":0,"e":"","id":"q6fdf82d258","t":"l","s":""},{"q":"'সমক্ষ' শব্দের বিপরীত শব্দ কোনটি?","o":["তুলনীয়","পরোক্ষ","অনুক্ষ","প্রত্যক্ষ"],"a":1,"e":"","id":"q8b2e0ca832","t":"l","s":""},{"q":"'বিরক্ত' এর বিপরীত শব্দ-","o":["শক্ত","আনন্দ","অনুরক্ত","আদরণীয়"],"a":2,"e":"","id":"qab9c345ac0","t":"l","s":""},{"q":"'ধৃষ্ট' শব্দের বিপরীতার্থক শব্দ কোনটি?","o":["নরম","নিরীহ","সরল","নম্র"],"a":3,"e":"","id":"qc82803d0b2","t":"l","s":""},{"q":"‘বন্দনা’ শব্দের বিপরীত শব্দ কোনটি?","o":["প্রশংসা","গঞ্জনা","বিরাগী","নিন্দা"],"a":1,"e":"","id":"qcac7528307","t":"l","s":""},{"q":"নিচের কোন শব্দযুগল বিপরীতার্থক নয়?","o":["হর্ষ-ঘৃণ্য","সুুশীল- দুঃশীল","মজবুত-ঠুনকো","সুধা-গরল"],"a":0,"e":"","id":"q003ce4fc63","t":"l","s":""},{"q":"'আদান' শব্দের বিপরীত শব্দ কোনটি?","o":["প্রস্থান","প্রধান","প্রমাণ","প্রদান"],"a":3,"e":"আদান মানে গ্রহণ করা বা নেওয়া। এর বিপরীত প্রদান, অর্থাৎ দেওয়া। আদান-প্রদান কথাটি আমরা প্রায়ই একসঙ্গে বলি। অন্য অপশনগুলোর ধ্বনি কাছাকাছি হলেও অর্থ আলাদা; প্রস্থান মানে যাত্রা, প্রধান মানে মুখ্য, আর প্রমাণ মানে সাক্ষ্য।\nমনে রাখুন:\nআদান ↔ প্রদান\nগ্রহণ ↔ বর্জন\nউদাহরণ: বইয়ের আদান-প্রদান","id":"q041fa0ba5d","t":"l","s":""},{"q":"' দেউড়ি' শব্দটির বিপরীত শব্দ কি?","o":["অলিন্দ","বাতায়ণ","গবাক্ষ","খিড়কি"],"a":3,"e":"","id":"q0494933755","t":"l","s":""},{"q":"'সন্ধি' এর বিপরীত শব্দ কোনটি?","o":["বিগ্রহ","বিচ্ছেদ","বিবাদ","ক ও গ"],"a":3,"e":"","id":"q08830c8112","t":"l","s":""},{"q":"'শুক্ল' শব্দের বিপরীত শব্দ কোনটি?","o":["লোহিত","পীত","কৃষ্ণ","নীল"],"a":2,"e":"শুক্ল মানে সাদা বা উজ্জ্বল। এর বিপরীত শব্দ কৃষ্ণ, অর্থাৎ কালো। চান্দ্রমাসের যে পক্ষে চাঁদ বাড়ে, তাকে শুক্লপক্ষ বলে, আর যে পক্ষে কমে, তাকে কৃষ্ণপক্ষ বলে। লোহিত মানে লাল, পীত মানে হলুদ।\nমনে রাখুন:\nশুক্ল ≠ কৃষ্ণ\nশুক্লপক্ষ ≠ কৃষ্ণপক্ষ\nলোহিত = লাল, পীত = হলুদ","id":"q09e4594ed0","t":"l","s":""},{"q":"'ক্ষয়িষ্ণু' শব্দের বিপরীতার্থক শব্দ কোনটি?","o":["বর্ধমান","বর্ধিষ্ণু","ক্ষীয়মান","নিভন্ত","কোনোটিই নয়"],"a":1,"e":"","id":"q0aab00438f","t":"l","s":""},{"q":"‘খুশি’ শব্দের বিপরীত শব্দ কি?","o":["ভাণ্ডার","উঠে","সকাল","অখুশি"],"a":3,"e":"","id":"q0d9fe0d71d","t":"l","s":""},{"q":"‘বিকর্ষণ’ শব্দের বিপরীতার্থক শব্দ কোনটি?","o":["উহ্য","উক্ত","আকর্ষণ","বিযুক্ত"],"a":2,"e":"","id":"q13f8b8a426","t":"l","s":""}]
