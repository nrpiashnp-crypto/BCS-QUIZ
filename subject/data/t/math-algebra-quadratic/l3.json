[{"q":"4x² − 12x + k রাশিটি একটি পূর্ণবর্গ হলে k এর মান কত?","o":["3","9","6","36"],"a":1,"e":"পূর্ণবর্গ রাশি হলো (a − b)² = a² − 2ab + b² আকারের রাশি। এখানে 4x² = (2x)², সুতরাং a = 2x। মাঝের পদ 12x = 2 × 2x × b, তাই b = 3।\nঅতএব k = b² = 3² = 9। যাচাই: (2x − 3)² = 4x² − 12x + 9।\nমনে রাখুন:\nax² + bx + c পূর্ণবর্গ হলে b² = 4ac হয়।","id":"q8d804772df","t":"l","s":""},{"q":"5x 2 - 3x + 4 = 0 সমীকরণের মূলদ্বয়ের প্রকৃতি নিচের কোনটি?","o":["বাস্তব ও সমান","মূলদ ও অসমান","অবাস্তব ও অসমান","বাস্তব ও অসমান"],"a":2,"e":"","id":"q8e5e0d97e7","t":"l","s":""},{"q":"যদি 2x 2 + mx + 6 = 0 সমীকরণের মূল দুইটি সমান হয় এবং m > 0 হলে, m এর মান কত?","o":["4√3","2√6","3√4","6√3"],"a":0,"e":"","id":"q9095fa26df","t":"l","s":""},{"q":"2x 2 - 6x - 5 = 0 এর মূলদ্বয়ের যোগফল কত?","o":["4","1/3","1/2","3"],"a":3,"e":"","id":"q9184f848ce","t":"l","s":""},{"q":"If (4P + 1) 2 = 441, then P 3 /3P = ?","o":["25/3","3/25","18/5","20/3"],"a":0,"e":"(4P + 1)² = 441 হলে 4P + 1 = 21 (P ধনাত্মক ধরে), তাই 4P = 20 এবং P = 5। এখন P³/3P = 125/15 = 25/3।","id":"q94679dadd0","t":"l","s":""},{"q":"2x 2 - 5x + 3 = 0 সমীকরণের মূলদ্বয় কোনটি?","o":["1, (- 3/2)","1, (3/2)","1, (2/3)","2, 3"],"a":1,"e":"","id":"q9594fd1d7b","t":"l","s":""},{"q":"x 2 - 8x + 16 = 0 সমীকরণের মূলদ্বয়ের প্রকৃতি কোনটি?","o":["বাস্তব ও অসমান","বাস্তব ও সমান","মূলদ ও অসমান","অবাস্তব ও অসমান"],"a":1,"e":"","id":"q96f58bf9d2","t":"l","s":""},{"q":"x 2 - x - 4 = 0 সমীকরণের মূলদ্বয়ের প্রকৃতি কেমন?","o":["অবাস্তব ও অসমান","বাস্তব ও সমান","বাস্তব ও অসমান","অবাস্তব ও সমান"],"a":2,"e":"","id":"q988814fea5","t":"l","s":""},{"q":"6x 2 - 7x - 4 = 0 সমীকরণের মূলদ্বয়ে প্রকৃতি কেমন?","o":["বাস্তব ও অসমান","বাস্তব ও সমান","অবাস্তব ও অসমান","মূলদ ও অসমান"],"a":0,"e":"","id":"q994c3d53f6","t":"l","s":""},{"q":"3x 2 + 5x + 2 = 0 সমীকরণের মূলদ্বয়ের প্রকৃতি কী?","o":["অবাস্তব ও সমান","বাস্তব ও অসমান","অবাস্তব ও অসমান","বাস্তব ও সমান"],"a":1,"e":"","id":"q9d753b9677","t":"l","s":""},{"q":"x 2 - 5x + 6 = 0 সমীকরণের মূলদ্বয়ের প্রকৃতি কোনটি?","o":["অবাস্তব বা কাল্পনিক","বাস্তব ও সমান","বাস্তব, অসমান ও মূলদ","কোনোটিই নয়"],"a":2,"e":"","id":"qa2a295c320","t":"l","s":""},{"q":"x 2 - 6x + 9 = 0 সমীকরণের মূলদ্বয়ের প্রকৃতি কোনটি?","o":["বাস্তব, অসমান ও মূলদ","অবাস্তব ও অসমান","বাস্তব ও সমান","বাস্তব ও অমূলদ"],"a":2,"e":"","id":"qad3eb4acc0","t":"l","s":""},{"q":"3x 2 - 5x + 2 = 0 সমীকরণের মূলের প্রকৃতি কোনটি?","o":["বাস্তব, মূলদ ও অসমান","অবাস্তব","বাস্তব, অমূলদ ও অসমান","বাস্তব ও সমান"],"a":0,"e":"","id":"qaed99eca33","t":"l","s":""},{"q":"4x 2 - 12x + 9 = 0 সমীকরণের মূলদ্বয়ের প্রকৃতি কোনটি?","o":["বাস্তব, অসমান ও মূলদ","বাস্তব ও সমান","বাস্তব ও অসমান","বাস্তব মূল নেই"],"a":1,"e":"","id":"qb6ca374623","t":"l","s":""},{"q":"2x² − 5x − 3 = 0 সমীকরণের সমাধান সেট কোনটি?","o":["{−3, 1/2}","{3, 1/2}","{−3, −1/2}","{3, −1/2}"],"a":3,"e":"মধ্যপদ বিভাজন করি: 2x² − 5x − 3 = 2x² − 6x + x − 3 = 2x(x − 3) + 1(x − 3) = (x − 3)(2x + 1)।\nসুতরাং x − 3 = 0 হলে x = 3 এবং 2x + 1 = 0 হলে x = −1/2।\nযাচাই: x = 3 বসালে 18 − 15 − 3 = 0।\nমনে রাখুন:\nax² + bx + c-এ ac = −6 এবং b = −5, তাই −6 ও +1 নিয়ে মধ্যপদ ভাঙা হয়েছে।","id":"qb736598454","t":"l","s":""},{"q":"2x 2 + 5x - 3 সমীকরণে মূলদ্বয়ের প্রকৃতি কোনটি?","o":["বাস্তব ও সমান","অসমান ও কাল্পনিক","বাস্তব ও অসমান","কাল্পনিক"],"a":2,"e":"","id":"qb893e45954","t":"l","s":""},{"q":"12x 2 + 4kx + 3 = 0 সমীকরণের মূলদ্বয় বাস্তব ও সমান হলে k এর মান কত?","o":["k = ± 2","k = ± 9","k = ± 3","k = 4"],"a":2,"e":"","id":"qbee495847c","t":"l","s":""},{"q":"p 2 - 6p + 9 = 0 সমীকরণের মূল কয়টি?","o":["1 টি","3 টি","2 টি","4 টি"],"a":2,"e":"","id":"qbfa148ad17","t":"l","s":""},{"q":"ax 2 + bx + c = 0 সমীকরণের মূল দুইটি বাস্তব ও পরস্পর সমান হবে যদি-","o":["b 2 – 4ac = 0","b 2 – 4ac > 0 এবং পূর্ণবর্গ","b 2 – 4ac < 0","b 2 – 4ac > 0 এবং পূর্ণবর্গ নয়"],"a":0,"e":"","id":"qc3bda39d79","t":"l","s":""},{"q":"If α, β are the roots of the equation x 2 - 15x + 36 = 0, then αβ equals to:","o":["12","3","0","36"],"a":3,"e":"দ্বিঘাত সমীকরণ ax² + bx + c = 0-এর মূলদ্বয়ের গুণফল c/a। এখানে c/a = 36। উৎপাদকে ভেঙেও দেখা যায়: (x − 12)(x − 3) = 0, মূল 12 ও 3, গুণফল 36।","id":"qc455cc410f","t":"l","s":""}]
