[{"q":"শুদ্ধ সন্ধি-বিচ্ছেদ কোনটি?","o":["যথা + উচিত = যথোচিত","নৈ + অন = নয়ন","গৌ + আদি = গবাদি","মার্ত + ওণ্ড = মার্তণ্ড"],"a":0,"e":"","id":"qf57444547d","t":"l","s":""},{"q":"সন্ধির সূত্র কাজে লাগে কখন?","o":["সমাস প্রক্রিয়ায়","প্রত্যয় প্রক্রিয়ায়","উপসর্গ প্রক্রিয়ায়","সবগুলো"],"a":3,"e":"","id":"qf6affc1707","t":"l","s":""},{"q":"'হাচ্ছানি' শব্দের যথার্থ সন্ধি বিচ্ছেদ কোনটি?","o":["হট্‌ + ছানি","হাচ + ছানি","হাত + চানি","হাত + ছানি"],"a":3,"e":"<p>'হাচ্ছানি' আসলে 'হাতছানি' শব্দের উচ্চারিত রূপ, আর এর সন্ধিবিচ্ছেদ হাত + ছানি। এটি খাঁটি বাংলা ব্যঞ্জনসন্ধির উদাহরণ, যেখানে উচ্চারণের সুবিধায় আগের ধ্বনি পরের ধ্বনির মতো হয়ে যায়—ত + ছ মিলে চ্ছ। একই ধরনের উদাহরণ: বদ + জাত = বজ্জাত, নাত + জামাই = নাজ্জামাই। হট্‌ + ছানি বা হাচ + ছানি অর্থহীন বিভাজন, আর হাত + চানি দিলে মূল শব্দ 'ছানি' থাকে না। সংস্কৃত সন্ধিতেও ত্ + ছ = চ্ছ হয়, যেমন উৎ + ছেদ = উচ্ছেদ।</p>","id":"qf6c7df5d4e","t":"l","s":""},{"q":"নিপাতনে সিদ্ধ সন্ধি কোনটি?","o":["অত্যন্ত","অন্বিত","অন্বেষণ","অন্যান্য"],"a":3,"e":"","id":"qf7067cbb0a","t":"l","s":""},{"q":"'তপোবন' শব্দের সঠিক সন্ধি বিচ্ছেদ কোনটি?","o":["তপো + বন = তপোবন","তপোঃ + বনৎ= তপোবন","তপঃ + বন = তপোবন","তপ + বন = তপোবন"],"a":2,"e":"","id":"qf757ebecf8","t":"l","s":""},{"q":"সঠিক সন্ধি বিচ্ছেদ কোনটি?","o":["ষট্ + দশ = ষোড়শ","দুষ + কর = দুষ্কর","গোষ্‌ + পদ = গোষ্পদ","আশ্‌ + চর্য = আশ্চর্য"],"a":0,"e":"","id":"qf7c84ff43e","t":"l","s":""},{"q":"'উদ্ধার' এর সঠিক সন্ধি বিচ্ছেদ নিচের কোনটি?","o":["উৎ + ধার","উত + দার","উৎ + হার","উতৎ + হার","কোনোটিই নয়"],"a":2,"e":"","id":"qf7cfdd5bbe","t":"l","s":""},{"q":"'মৃন্ময়' এর সঠিক সন্ধি বিচ্ছেদ -","o":["মৃন্‌ + অয়","মৃন্‌ + ময়","মৃৎ + ময়","মৃ + ময়"],"a":2,"e":"","id":"qf84a13ecca","t":"l","s":""},{"q":"'পর্যালোচনা' এর সঠিক সন্ধিবিচ্ছেদ কোনটি?","o":["পরি + লোচনা","পর্য + আলোচনা","পরি + আলোচনা","পরিঃ + আলোচনা"],"a":2,"e":"","id":"qf88e8437e2","t":"l","s":""},{"q":"'শুদ্ধোদন' শব্দের সঠিক সন্ধিবিচ্ছেদ কোনটি?","o":["শুদ্ধ + ওদন","শুদ্ধ + উদন","শুদ্ধ + অদন","শুদ্ধি + ওধন"],"a":0,"e":"","id":"qf8decb5f0f","t":"l","s":""},{"q":"\"তন্মধ্যে\" শব্দটি কোন সন্ধিতে গঠিত?","o":["বিসর্গ","ব্যঞ্জনসন্ধি","স্বরসন্ধি","নিপাতনে সিদ্ধ","কোনটিই নয়"],"a":1,"e":"","id":"qf963ff1872","t":"l","s":""},{"q":"দুরূহ শব্দের সঠিক সন্ধিবিচ্ছেদ কী?","o":["দুঃ + ঊহ","দুঃ + উহ","দুরঃ + ঊহ","দুরঃ + উহ"],"a":0,"e":"সঠিক উত্তর দুঃ + ঊহ। 'দুরূহ' এ রেফ র থাকায় সন্ধি ভাঙলে র-এর জায়গায় বিসর্গ বসে। দুঃ (কঠিন) + ঊহ (বিচার) = দুরূহ। একই নিয়মে চতুঃ + অঙ্গ = চতুরঙ্গ, নিঃ + ঈহ = নিরীহ, দুঃ + আচার = দুরাচার, নিঃ + অবধি = নিরবধি।","id":"qf98071ca31","t":"l","s":""},{"q":"'উচ্চারণ' শব্দটি কোন ধরনের সন্ধিযোগে গঠিত?","o":["ব্যঞ্জনসন্ধি","নিপাতনে সিদ্ধ সন্ধি","স্বরসন্ধি","বিসর্গ সন্ধি"],"a":0,"e":"","id":"qfa21b12d12","t":"l","s":""},{"q":"'তিরোধান' শব্দের সঠিক সন্ধি-বিচ্ছেদ কী?","o":["তিরঃ + ধান","তিরোঃ + ধান","তিরো + ধান","তীর + ধান"],"a":0,"e":"","id":"qfae9d09624","t":"l","s":""},{"q":"'পবিত্র' শব্দের সঠিক সন্ধি বিচ্ছেদ কী হবে?","o":["পো + ইত্র","পোঃ + বিত্র","পো + বিত্র","পৌ + ইত্র"],"a":0,"e":"","id":"qfb16370d2a","t":"l","s":""},{"q":"নিচের কোনটি বিসর্গ সন্ধির উদাহরণ নয়?","o":["নীরব","বৃহস্পতি","আর্শীবাদ","পুরস্কার"],"a":1,"e":"","id":"qfb22032019","t":"l","s":""},{"q":"'যশোলাভ' শব্দের সন্ধি বিচ্ছেদ -","o":["যশঃ + লাভ","যশো + লাভ","যোশ + লাভ","যশ + লাভ"],"a":0,"e":"","id":"qfba291d246","t":"l","s":""},{"q":"'মন্বন্তর' শব্দের শুদ্ধ সন্ধি বিচ্ছেদ কোনটি?","o":["মন্ব + অন্তর","মনু + অন্তর","মনব + অন্তর","মনো + অন্তর"],"a":1,"e":"","id":"qfc4430e36a","t":"l","s":""},{"q":"'দুরাত্মা' শব্দের শুদ্ধ সন্ধি বিচ্ছেদ কোনটি?","o":["দুঃ + আত্মা","দুরা্‌ + আত্মা","দুরহ্‌ + আত্মা","দুর্‌ + আত্মা"],"a":0,"e":"","id":"qfc725e44b7","t":"l","s":""},{"q":"৫. 'ষষ্ঠ'-শব্দের সন্ধি-বিচ্ছেদ কোনটি?","o":["ষষ্ +থ্","ষষঃ + থ","ষষঃ + ট","ষষঃ+ঠ"],"a":0,"e":"<p>‘ষষ্ঠ’ শব্দের সন্ধিবিচ্ছেদ ষষ্ + থ। এটি ব্যঞ্জনসন্ধির নিয়ম: ষ-এর পরে ত বা থ এলে সেগুলো যথাক্রমে ট ও ঠ হয়ে যায়, তাই ষ্ + থ মিলে ‘ষ্ঠ’ হয়েছে। একই নিয়মের আরেকটি উদাহরণ কৃষ্ + ত = কৃষ্ট। অপশনে ‘ষষ্ +থ্’ লেখায় থ-এর নিচের হসন্ত ছাপার ভুল, মূল বিচ্ছেদ ষষ্ + থ। ষষঃ নামে কোনো শব্দ নেই, তাই বিসর্গযুক্ত অন্য অপশনগুলো ভুল, আর ‘ঠ’ সন্ধির ফল, বিচ্ছেদের অংশ নয়। একই ধাঁচের প্রশ্নে ‘উচ্ছেদ’ (উৎ + ছেদ) ও ‘উল্লেখ’ (উৎ + লেখ)-এর মতো ব্যঞ্জনসন্ধি প্রায়ই আসে।</p>","id":"qfc828e89ce","t":"l","s":""}]
