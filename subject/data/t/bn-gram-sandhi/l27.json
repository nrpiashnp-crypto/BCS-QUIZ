[{"q":"বিসর্গ সন্ধি সাধিত শব্দ-","o":["আদ্যন্ত","প্রত্যুষ","অত্যধিক","তপোবন"],"a":3,"e":"","id":"q9b6d5b0b29","t":"l","s":""},{"q":"'কুলটা' শব্দের সন্ধি বিচ্ছেদ কোনটি?","o":["কোল+অটা","কুল+টা","কুল+অটা","কোল+টা"],"a":2,"e":"","id":"q9cabb8ee17","t":"l","s":""},{"q":"‘পবিত্র’ শব্দটির সঠিক সন্ধিবিচ্ছেদ কোনটি?","o":["পো + ইত্র","পাব + ইত্র","প + ইত্র","পৌ + ইত্র"],"a":0,"e":"","id":"q9cec34382e","t":"l","s":""},{"q":"নিচের কোনটি নিপাতনে সিদ্ধ সন্ধি?","o":["পরিষ্কৃত","ষড়ানন","ষোড়শ","পরিষ্কার","সংস্কার"],"a":2,"e":"","id":"q9e298c6902","t":"l","s":""},{"q":"'যথোপযুক্ত' শব্দের শুদ্ধ সন্ধি বিচ্ছেদ কোনটি?","o":["যথঃ + উপযুক্ত","যথাঃ + উপযুক্ত","যথো + উপযুক্ত","যথা + উপযুক্ত"],"a":3,"e":"","id":"q9e617c9c0f","t":"l","s":""},{"q":"নিচের কোন সন্ধি বিচ্ছেদটি সঠিক নয়?","o":["বন + ওষুধি = বনৌষধি","মহা + ওষুধি = মহৌষধি","পরম + ওষুধি = পরমৌষধ","মহা + ঔষধ = মহৌষধ"],"a":null,"e":"","id":"q9e97648f5b","t":"l","s":""},{"q":"নিচের কোন সন্ধিবিচ্ছেদটি সঠিক?","o":["লে + অন = লবণ","শে + অন = শয়ন","ভো + উক = ভাবুক","গোঃ + এষণা = গবেষণা"],"a":1,"e":"সঠিক বিচ্ছেদ 'শে + অন = শয়ন'। সূত্র: এ-কারের পরে স্বর এলে এ স্থানে অয়, ঐ-কারের পরে স্বর এলে আয়, ও-কারের পরে অব্ আর ঔ-কারের পরে আব্ হয়। যেমন নয়ন (নে + অন), নায়ক (নৈ + অক), পবন (পো + অন), লবণ (লো + অন), পবিত্র (পো + ইত্র)। বিকল্পের ভুল দুটি ধরুন: ভাবুক হয় ভৌ + উক থেকে, আর গবেষণা হয় গো + এষণা থেকে (গোঃ নয়)।","id":"q9ebb6b497f","t":"l","s":""},{"q":"‘নিরাকার’ এর সঠিক সন্ধি বিচ্ছেদ -","o":["নিঃ + আকার","নির্‌ + কার","নি + আকার","নির + আকার"],"a":0,"e":"","id":"q9f38822469","t":"l","s":""},{"q":"'সপ্তর্ষি' শব্দের সঠিক সন্ধি বিচ্ছেদ কোনটি ?","o":["সুপ্ত + ঋষি","সপ্ত + ঋষি","সপ্ত + ঋষিজ","সপ্তা + ঋষি"],"a":1,"e":"সঠিক উত্তর সপ্ত + ঋষি। এটি স্বরসন্ধি। নিয়ম: অ বা আ-এর পরে ঋ থাকলে দুটি মিলে 'অর্' হয় এবং তা রেফ হয়ে পরের বর্ণের মাথায় বসে। সপ্ত-এর 'অ' এবং ঋষি-র 'ঋ' মিলে সপ্তর্ষি। এ রকম আরও: দেবর্ষি (দেব + ঋষি), মহর্ষি (মহা + ঋষি), রাজর্ষি, অধমর্ণ, উত্তমর্ণ।","id":"q9fa14298db","t":"l","s":""},{"q":"সন্ধিঘটিত কোন শব্দটি শুদ্ধ?","o":["শিরোচ্ছেদ","আদ্যান্ত","জাত্যাভিমান","মহেশ্বর"],"a":3,"e":"শুদ্ধ শব্দ ‘মহেশ্বর’ (মহা + ঈশ্বর; আ + ঈ = এ)। অন্য তিনটির শুদ্ধ রূপ: জাত্যভিমান (জাতি + অভিমান; ‘জাত্যাভিমান’ নয়), আদ্যন্ত (আদি + অন্ত; ‘আদ্যান্ত’ নয়), শিরশ্ছেদ (শিরঃ + ছেদ; ‘শিরোচ্ছেদ’ নয়)।","id":"q9fbc20b3d7","t":"l","s":""},{"q":"'শাঁখারি' শব্দের সঠিক সন্ধি বিচ্ছেদ কোনটি?","o":["শাখ + আরি","শাঁখা + আরি","শাখা + আরি","শাঁখ + আরি"],"a":1,"e":"","id":"q9fcba53937","t":"l","s":""},{"q":"নিচের কোন সন্ধি-বিচ্ছেদটি সঠিক?","o":["জন+অক = জনৈক","নৌ+বিক = নাবিক","নৈ+অক = নায়ক","মহা+ঋর্ষি =মহর্ষি"],"a":2,"e":"","id":"q9fd6c6a3bb","t":"l","s":""},{"q":"'সুবন্ত' শব্দটির সঠিক সন্ধি বিচ্ছেদ কোনটি?","o":["সুপ্ + বন্ত","সূপ্ + অন্ত","সুপ্ + অন্ত","সুব্ + অন্ত"],"a":2,"e":"","id":"q9fd8a2f472","t":"l","s":""},{"q":"'নীরস' শব্দের সঠিক সন্ধি বিচ্ছেদ কোনটি?","o":["নি + রস","নীঃ + রস","নিঃ + রস","নী + রস"],"a":2,"e":"","id":"qa0d380d2eb","t":"l","s":""},{"q":"কোনটি বিশেষ নিয়মে সাধিত সন্ধি?","o":["সংস্কৃতি","তস্কর","একাদশ","সবগুলো"],"a":0,"e":"","id":"qa10a34669c","t":"l","s":""},{"q":"'সংযম' শব্দের সন্ধিবিচ্ছেদ-","o":["সং + যম","সৎ + যম","সম্‌ + যম","সম + য"],"a":2,"e":"","id":"qa12ae99537","t":"l","s":""},{"q":"নিচের কোনটি বিসর্গ সন্ধি নয়?","o":["তপোবন","প্রাতরাশ","মনোহর","মহর্ষি"],"a":3,"e":"","id":"qa151217eef","t":"l","s":""},{"q":"\"আ + উ = ও\"- সন্ধি বিচ্ছেদের এই নিয়মে গঠিত শব্দ কোনটি?","o":["দীর্ঘোচ্চারণ","গঙ্গোর্মি","নবোঢ়া","কথোপকথন"],"a":3,"e":"","id":"qa15530f7bb","t":"l","s":""},{"q":"'পৃথ্বীশ' শব্দের সঠিক সন্ধিবিচ্ছেদ কোনটি?","o":["পৃথ্বি + ঈশ","পৃথি + ঈশ","পৃথ্বী + ঈশ","পৃথী + ঈশ"],"a":2,"e":"","id":"qa15645543e","t":"l","s":""},{"q":"'ভাবুক' শব্দের সঠিক সন্ধিবিচ্ছেদ -","o":["ভৌ+উক","ভাব+ঊক","ভাউ+বুক","ভা+বিক"],"a":0,"e":"","id":"qa1a5684545","t":"l","s":""}]
