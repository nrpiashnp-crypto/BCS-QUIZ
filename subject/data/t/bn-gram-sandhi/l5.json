[{"q":"‘উত্তমর্ণ’ শব্দের সন্ধি বিচ্ছেদ কোনটি","o":["উত্তম+ঋণ","উত্তম+ঋত","উত্তম+উম্ম","উত্তম+মর্ণ"],"a":0,"e":"","id":"qdfb01251fa","t":"l","s":""},{"q":"'পরিষ্কার' শব্দের সন্ধি বিচ্ছেদ -","o":["পরি + কার","পর + কার","পরিস + কার","পরি + ষ্কার"],"a":0,"e":"","id":"qe2ab3f87d6","t":"l","s":""},{"q":"'বনস্পতি' শব্দের সঠিক সন্ধি বিচ্ছেদ-","o":["বনঃ+পতি","বনস্‌+পতি","বন্‌স+পতি","বন্‌+পতি"],"a":3,"e":"‘বনস্পতি’ শব্দের সন্ধিবিচ্ছেদ বন্‌ + পতি। কোনো সাধারণ বা বিশেষ নিয়মে এর ব্যাখ্যা মেলে না, অথচ ভাষায় প্রচলিত; এমন ব্যতিক্রমকে নিপাতনে সিদ্ধ বলে, আর এটি ব্যঞ্জনসন্ধির অন্তর্গত। এ জাতীয় আরও শব্দ: বৃহস্পতি (বৃহৎ + পতি), পরস্পর (পর + পর), আশ্চর্য (আ + চর্য), ষোড়শ (ষট্ + দশ), একাদশ (এক + দশ), পতঞ্জলি (পতৎ + অঞ্জলি), গোষ্পদ (গো + পদ)।","id":"qe2c02a2ff8","t":"l","s":""},{"q":"'যথাযথ' শব্দের সঠিক সন্ধি বিচ্ছেদ কোনটি?","o":["যথঃ + যথ","যথা + অযথ","যথ + যথ","যথা + যথ"],"a":1,"e":"","id":"qe407bc9dea","t":"l","s":""},{"q":"নিচের কোনটি নিপাতনে সিদ্ধ স্বরসন্ধি?","o":["অন্যান্য","সীমান্ত","রক্তৌষ্ঠ","বিম্বোষ্ঠ"],"a":1,"e":"চাবিতে দেওয়া উত্তর সীমান্ত। স্বরসন্ধিতে নিয়মমতো সীমা + অন্ত = সীমান্ত হয়, আবার সীমন্ + অন্ত থেকে সীমন্ত রূপটি নিপাতনে সিদ্ধ ধরা হয়। অন্যান্য (অন্য + অন্য), বিম্বোষ্ঠ, রক্তোষ্ঠ নিপাতনে সিদ্ধ স্বরসন্ধির পরিচিত উদাহরণ। অর্থাৎ প্রশ্নের উত্তর নিয়ে বিভ্রান্তি আছে।","id":"qe438494c3d","t":"l","s":""},{"q":"'অক্ষৌহিণী' শব্দের সঠিক সন্ধি বিচ্ছেদ কোনটি?","o":["অক্ষ + ঊহিণী","অক্ষিয় + উহিণী","অক্ষ + উহিণী","অক্ষো + উহিণী"],"a":0,"e":"","id":"qee70e1b060","t":"l","s":""},{"q":"'পিত্রালয়' এর সঠিক সন্ধি বিচ্ছেদ কোনটি?","o":["পিতা+আলয়","পিতা+লয়","পিতৃ+আলয়","পিতৃ+লয়"],"a":2,"e":"","id":"qef9caf93e6","t":"l","s":""},{"q":"\"মহৌষধি\" শব্দটির সঠিক সন্ধি বিচ্ছেদ কোনটি?","o":["মহ + ওষধি","মহ + ঔষধি","মহা + ঔষধি","মহা + ওষধি"],"a":3,"e":"'মহৌষধি'-র সন্ধিবিচ্ছেদ মহা + ওষধি। অ বা আ-এর পরে ও বা ঔ এলে দুটি মিলে ঔ-কার হয়। উদাহরণ: বনৌষধি, কণ্ঠৌষধি, পরমৌষধ, মহৌষধ, চিত্তৌদার্য।","id":"qf0501432d4","t":"l","s":""},{"q":"'সন্ধান' এর সঠিক সন্ধি বিচ্ছেদ -","o":["সন্‌ + ধান","সম্‌ + ধান","সঃ + ধান","সং + ধান"],"a":1,"e":"","id":"q0064de55bc","t":"l","s":""},{"q":"'সম্প্রীতি' শব্দের শুদ্ধ সন্ধি বিচ্ছেদ কোনটি?","o":["সমঃ + প্রীতি","সম্ + প্রতি","সম্ + প্রীতি","সমো + প্রীতি"],"a":2,"e":"","id":"q0069b89c33","t":"l","s":""},{"q":"কোন শব্দটি বিসর্গসন্ধির মাধ্যমে গঠিত?","o":["পরিচ্ছন্ন","পরিচ্ছেদ","শিরশ্ছেদ","বিচ্ছেদ"],"a":2,"e":"","id":"q007b3cd209","t":"l","s":""},{"q":"নিচের কোনটি বিসর্গ সন্ধি নয়?","o":["অহরহ","ভাস্কর","বাচস্পতি","পরিষ্কার","সবগুলোই"],"a":3,"e":"","id":"q008cdb836c","t":"l","s":""},{"q":"'সঞ্চয়' শব্দের শুদ্ধ সন্ধি বিচ্ছেদ কোনটি?","o":["সম্ + চয়","সঞ্‌ + চয়","সন্‌ + চয়","সং + চয়"],"a":0,"e":"","id":"q0115deff52","t":"l","s":""},{"q":"'ভাবুক' শব্দের সন্ধি বিচ্ছেদ--","o":["ভৌ + উক","ভূ + উক","ভূ + অক","ভাব + উক"],"a":0,"e":"","id":"q01247981ed","t":"l","s":""},{"q":"‘মহার্ঘ’ শব্দটির সঠিক সন্ধি-বিচ্ছেদ কোনটি?","o":["মহা + অর্ঘ","মহান + অর্ঘ্য","মহা + অর্ঘ্য","মহৎ + অর্ঘ"],"a":0,"e":"'মহার্ঘ'-এর সঠিক বিচ্ছেদ মহা + অর্ঘ। আ + অ মিলে আ হয় (স্বরসন্ধি)। অনুরূপ: আশাতীত (আশা + অতীত), ত্বরান্বিত, যথাযথ। অর্ঘ মানে মূল্য; মহার্ঘ মানে বহুমূল্য।","id":"q01901900bb","t":"l","s":""},{"q":"'বনৌষধি' শব্দটি কোন সন্ধিযোগে গঠিত?","o":["স্বরসন্ধি","নিপাতনে সিদ্ধ সন্ধি","ব্যঞ্জনসন্ধি","বিসর্গ সন্ধি"],"a":0,"e":"'বনৌষধি' স্বরসন্ধিযোগে গঠিত (বন + ওষধি)। সূত্র: অ বা আ-এর পর ও বা ঔ থাকলে দুয়ে মিলে ঔ হয় এবং ঔ-কার পূর্ববর্তী ব্যঞ্জনে যুক্ত হয়। উদাহরণ: বন + ওষধি = বনৌষধি; জন + এক = জনৈক; প্রতি + এক = প্রত্যেক। উল্লেখ্য, মহা + ঋষি = মহর্ষি ও শীত + ঋত = শীতার্ত অ/আ + ঋ সূত্রে হয়।","id":"q01d332069e","t":"l","s":""},{"q":"'ক্ষুধার্ত' এর সঠিক সন্ধি বিচ্ছেদ কোনটি?","o":["ক্ষুধা + ঋণ","ক্ষুদা + ঋত","ক্ষুধা + রিত","ক্ষুধ + ঋত","কোনোটিই নয়"],"a":4,"e":"","id":"q0221518e8d","t":"l","s":""},{"q":"সন্ধি শব্দটি ব্যাকরণের কোন নিয়মে সাধিত শব্দ?","o":["সমাস","উপসর্গ","সন্ধি","প্রকৃতি ও প্রত্যয়"],"a":2,"e":"","id":"q034f2e10c9","t":"l","s":""},{"q":"সঠিক সন্ধি বিচ্ছেদ কোনটি?","o":["দিগ্‌ + অন্ত = দিগন্ত","সুপ্ + অন্ত = সুবন্ত","ণিজ্‌ + অন্ত = ণিজন্ত","ষঠ্‌ + আনন = ষড়ানন"],"a":1,"e":"","id":"q03532181d3","t":"l","s":""},{"q":"'বনৌষধি' - শব্দের শুদ্ধ সন্ধিবিচ্ছেদ কোনটি?","o":["বন + ঔষধ","বন + ওষধি","বন + ঔষধি","বন + ওষুধ"],"a":1,"e":"","id":"q035ff7f6c4","t":"l","s":""}]
