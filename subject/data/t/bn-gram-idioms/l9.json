[{"q":"‘এত অল্প টাকায় মাস চলবে না' এই চলা কোন অর্থ প্রকাশ করেছে?","o":["অবলম্বন করা","প্রচলিত হওয়া","সংকুলান হওয়া","সময় দেয়া"],"a":2,"e":"","id":"qea5f5ad6a5","t":"l","s":""},{"q":"'ভুঁইফোঁড়' বাগধারাটির অর্থ-","o":["নতুন আগমন","নির্বোধ","সুযোগ সন্ধানী","কাণ্ডজ্ঞানহীন"],"a":0,"e":"","id":"qed1d07c258","t":"l","s":""},{"q":"'উজানের কৈ' বাগধারাটির অর্থ -----","o":["বিরাট আয়োজন","অপদার্থ","সহজলভ্য","সামান্য পার্থক্য"],"a":2,"e":"","id":"qed21ea719f","t":"l","s":""},{"q":"'কড়ি কপালে' বাগধারাটির অর্থ কী?","o":["হতভাগা","তিরস্কার","সামান্য","ভাগ্যবান"],"a":3,"e":"","id":"qee0dcb06c1","t":"l","s":""},{"q":"‘পাগলামি’ অর্থ প্রকাশ করে কোন বাগধারাটি?","o":["উলুখাগড়া","উড়নপেকে","উজলপাঁজল","ঊনপঞ্চাশ বায়ু"],"a":3,"e":"","id":"qf01480f5e5","t":"l","s":""},{"q":"'তেলে বেগুনে জ্বলে ওঠা' বাগধারাটির অর্থ—","o":["সুযোগ পাওয়া","খুব আনন্দিত হওয়া","অত্যন্ত রেগে যাওয়া","বিপদে পড়া"],"a":2,"e":"তপ্ত তেলে বেগুন দিলে যেমন ছ্যাঁৎ শব্দ করে ওঠে, তেমনি কেউ হঠাৎ প্রচণ্ড রেগে গেলে বলা হয় 'তেলে বেগুনে জ্বলে ওঠা'। অর্থাৎ বাগধারাটির অর্থ অত্যন্ত রেগে যাওয়া।\nমনে রাখুন:\n'অগ্নিশর্মা'-ও রাগে জ্বলে ওঠা বোঝায়।\nউদাহরণ: সামান্য কথায় তিনি তেলে বেগুনে জ্বলে উঠলেন।","id":"qf01d5a74bf","t":"l","s":""},{"q":"’হাত জুড়ানো’ বাগধারাটির অর্থ কি?","o":["মারা যাওয়া","বিশ্রাম নেয়া","আরোগ্য লাভ করা","স্বস্তি লাভ করা"],"a":3,"e":"","id":"qf162572dcf","t":"l","s":""},{"q":"গুড়ে বালি : আশায় নৈরাশ্য :: ? : ঢিলেমি","o":["হাড়হদ্দ","গয়ংগচ্ছ","সপ্তকান্ড রামায়ণ","তানকানা"],"a":1,"e":"","id":"qf4b6d1bab1","t":"l","s":""},{"q":"‘অগত্যা মধুসূদন’ বাগ্‌ধারার অর্থ -","o":["শেষ শয্যা","অনন্যোপায়","অন্তর্গত আঘাত","শেষ যাত্রা"],"a":1,"e":"সঠিক উত্তর অনন্যোপায়। 'অগত্যা মধুসূদন' বাগ্ধারা বোঝায়, অন্য কোনো পথ না পেয়ে বাধ্য হয়ে ভগবানের নাম নিয়ে কাজে নামা। অন্য বিকল্পগুলো ভিন্ন বাগ্ধারার অর্থ: অনন্তশয্যা মানে শেষ শয্যা (মৃত্যু), অগস্ত্যযাত্রা মানে শেষ যাত্রা, আর অঙ্কুশ-তাড়না মানে ভেতর থেকে আঘাত বা বেদনা।","id":"qf4db435404","t":"l","s":""},{"q":"'আদিখ্যেতা' বাগধারাটির অর্থ কি?","o":["ন্যাকামি","পাগলামি","দুষ্টামি","দুর্লভ বস্তু","কোনোটিই নয়"],"a":0,"e":"","id":"qf59b99f157","t":"l","s":""},{"q":"'ভণ্ড' অর্থে কোন বাগধারাটি ব্যবহৃত হয়েছে?","o":["বইয়ের পোকা","বর্ণচোরা","থতমত খাওয়া","ননীর পুতুল"],"a":1,"e":"","id":"qf6481bde61","t":"l","s":""},{"q":"‘বামনের গরু’ বাগধারাটি কী অর্থ প্রকাশ করে?","o":["নিষ্ফল পরিশ্রম করা","যে অল্প পারিশ্রমিকে বেশি কাজ করে","ক্ষমতা প্রদর্শন","সরল লোককে প্রতারণা"],"a":1,"e":"","id":"qf6be7529d0","t":"l","s":""},{"q":"'সহজলভ্য' অর্থ প্রকাশ করে নিচের কোনটি?","o":["পুঁটি মাছের প্রাণ","উজানের কৈ","ঝাঁকের কৈ","উলুখাগড়া"],"a":1,"e":"","id":"qf803d04c69","t":"l","s":""},{"q":"সাতকাহন","o":["অলিক কথা","সুখের সময়","জগা খিচড়ি","সংঘাত","কোনোটিই নয়"],"a":4,"e":"","id":"qf9cd42dd57","t":"l","s":""},{"q":"'সপ্তকাণ্ড রামায়ণ' বাগ্‌ধারার অর্থ কী?","o":["বৃহৎ বিষয়","রামায়ণের সাত পর্ব","রামায়ণে বর্ণিত সাতটি সমুদ্র","রামায়ণে বর্ণিত বৃক্ষ"],"a":0,"e":"","id":"qf9f2da84df","t":"l","s":""},{"q":"‘সাক্ষী গোপাল’ বাগধারাটির সঠিক অর্থ কি?","o":["নিরেট মূর্খ","নির্বোধ","নিষ্ক্রিয় দর্শক","কাণ্ডজ্ঞানহীন"],"a":2,"e":"","id":"qfae25dec1e","t":"l","s":""},{"q":"'ইঁদূর কপালে' বাগধারাটির অর্থ ---","o":["কিম্ভুত","মন্দভাগ্য","ছোট কপাল","সৌভাগ্যবান"],"a":1,"e":"","id":"qfae511df5b","t":"l","s":""},{"q":"'আমড়া কাঠের ঢেকি' বাগধারাটির অর্থ কি?","o":["মিথ্যাবাদী","চোর","অপদার্থ","জ্ঞানী"],"a":2,"e":"","id":"qfb51d0ba96","t":"l","s":""},{"q":"'ছেলেটিকে চোখে চোখে রেখো'। কী অর্থ প্রকাশ করছে?","o":["সতর্কতা","বিপদ","আশঙ্কা","ভয়"],"a":0,"e":"‘ছেলেটিকে চোখে চোখে রেখো’ বাক্যে সতর্কতা বা সজাগ নজর রাখার অর্থ প্রকাশ পেয়েছে। দ্বিরুক্ত শব্দ বা পদ বাক্যে বিশেষ ভাব আনে: ‘চোখে চোখে রাখা’ মানে সর্বক্ষণ নজর রাখা, অর্থাৎ সতর্কতা। অন্যান্য ভাবের উদাহরণ: বাছা বাছা ফুল (প্রগাঢ়তা বা বিশেষত্ব), হাড়ে হাড়ে শয়তান (আধিক্য), থেকে থেকে কাঁদা (কালের বিস্তার বা পৌনঃপুন্য)। এখানে বিপদ, আশঙ্কা বা ভয় কোনোটাই বক্তব্যের মূল নয়।","id":"qff6b45dac3","t":"l","s":""}]
