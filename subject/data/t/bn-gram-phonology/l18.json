[{"q":"নিচের কোনটি মহাপ্রাণ ব্যঞ্জন?","o":["ড","জ","ধ","গ"],"a":2,"e":"মহাপ্রাণ ব্যঞ্জন ধ। উচ্চারণের সময় ফুসফুস থেকে বাতাস তুলনামূলক বেশি বের হলে সেটি মহাপ্রাণ ধ্বনি; কম বের হলে অল্পপ্রাণ।\n- মহাপ্রাণ: খ, ঘ, ছ, ঝ, ঠ, ঢ, থ, ধ, ফ, ভ ও হ।\n- অল্পপ্রাণ: ক, গ, চ, জ, ট, ড, ত, দ, প, ব, স, শ।\nপ্রশ্নের ড, জ, গ অল্পপ্রাণ। মনে রাখার উপায়: বর্গের দ্বিতীয় ও চতুর্থ বর্ণ মহাপ্রাণ।","id":"q3f62a6f93f","t":"l","s":""},{"q":"নাসিক্য বর্ণ নয় কোনটি?","o":["ন","ম","ঞ","ও","ণ"],"a":3,"e":"","id":"q3f85a70ea2","t":"l","s":""},{"q":"বাগ্‌যন্ত্রের স্বল্পতম প্রয়াসে উচ্চারিত ধ্বনি বা ধ্বনিগুচ্ছকে কী বলে?","o":["বর্ণ","মৌলিক স্বরধ্বনি","অক্ষর","যৌগিক স্বরধ্বনি"],"a":2,"e":"","id":"q3fd2ec30b8","t":"l","s":""},{"q":"অর্ধস্বরধ্বনি নয় কোনটি?","o":["ত্র্‌","ও্‌","ই্‌,","উ্‌"],"a":0,"e":"","id":"q401f1394f6","t":"l","s":""},{"q":"'ঙ'-এর ক্ষেত্রে কোন উচ্চারণটি শুদ্ধ?","o":["উয়ঁ","উঁয়ো","উঁঅ","উপরের সবগুলোই"],"a":3,"e":"","id":"q404f621808","t":"l","s":""},{"q":"ধ্বনির বিভাজন অনু্যায়ী বাংলা বর্ণমালাকে কয় ভাগে ভাগ করা হয়?","o":["দুই","পাঁচ","চার","তিন"],"a":0,"e":"","id":"q4090cc88e4","t":"l","s":""},{"q":"মাত্রাহীন ব্যঞ্জনবর্ণ কয়টি?","o":["৩টি","৭টি","৬টি","১০টি"],"a":2,"e":"মাত্রাহীন ব্যঞ্জনবর্ণ ৬টি: ঙ, ঞ, ৎ এবং চিহ্নগুলো ং, ঃ, ঁ। মাত্রাহীন বর্ণ মোট ১০টি; স্বরবর্ণের চারটি (ঐ, ঔ, এ, ও) বাদ দিলে বাকি ৬টি ব্যঞ্জন। অর্ধমাত্রার বর্ণ ৮টি, পূর্ণ মাত্রার বর্ণ ৩২টি। প্রশ্ন ব্যঞ্জনবর্ণের, তাই উত্তর ৬।","id":"q40f20d917e","t":"l","s":""},{"q":"কোনটি অর্ধ-সংবৃত স্বরধ্বনি?","o":["এ","ই","অ","উ"],"a":0,"e":"‘এ’ অর্ধ-সংবৃত স্বরধ্বনি। উচ্চারণের সময় মুখ কতটা খোলা থাকে তার ভিত্তিতে স্বর চার ভাগে বিভক্ত। সবচেয়ে কম খোলে ই ও উ-তে (সংবৃত)। এরপর এ ও ও (অর্ধ-সংবৃত)। তারপর অ্যা ও অ (অর্ধ-বিবৃত)। সবচেয়ে বেশি খোলে আ-তে (বিবৃত)। তাই ই, উ সংবৃত, আর অ অর্ধ-বিবৃত।","id":"q4128aa4d1a","t":"l","s":""},{"q":"উচ্চারণস্থান অনুসারে 'ল' কোন ধরনের ব্যঞ্জন?","o":["দন্তমূলীয় ব্যঞ্জন","তালব্য ব্যঞ্জন","মূর্ধন্য ব্যঞ্জন","দন্ত্য ব্যঞ্জন"],"a":0,"e":"","id":"q41c42e6de1","t":"l","s":""},{"q":"বাংলা বর্ণমালায় মাত্রাবিহীন বর্ণে