[{"q":"কোনটি সঠিক যুক্তবর্ণ?","o":["ঞ্ + জ = ঞ্জ","চ্‌ + ঞ্‌ = ঞ্চ","ছ্‌ + ঞ্ = ঞ্ছ","হ্‌ + ম = ক্ষ্ম"],"a":0,"e":"প্রথম বিকল্পের যুক্তবর্ণ গঠনটি ঠিক: ঞ্ আর জ মিলে ঞ্জ হয় (যেমন ব্যঞ্জন, রঞ্জন)। বাকি বিকল্প ভুল। 'ঞ্চ' গড়ে ঞ্ + চ (চ্ + ঞ্ নয়), 'ঞ্ছ' গড়ে ঞ্ + ছ (ছ্ + ঞ্ নয়), আর 'ক্ষ্ম' গড়ে ক্ + ষ্ + ম, হ ও ম মিলে ক্ষ্ম হয় না। যুক্তবর্ণে উচ্চারণের ক্রম মেনে বর্ণ বসে।","id":"q2369c6be2d","t":"l","s":""},{"q":"'নানা, রাত, লাল' — এই শব্দগুলোর প্রথম বর্ণগুলো কোন ধরনের ব্যঞ্জন?","o":["তালব্য ব্যঞ্জন","ওষ্ঠ্য ব্যঞ্জন","মূর্ধন্য ব্যঞ্জন","দন্তমূলীয় ব্যঞ্জন"],"a":3,"e":"","id":"q239ce8c1fb","t":"l","s":""},{"q":"'ব্যবহৃত' শব্দের যুক্তবর্ণে কোন দুটি বর্ণ যুক্ত হয়েছে?","o":["র্‌ + হ","হ্ + র","হ্ + ঋ","ঋ্‌ + হ"],"a":2,"e":"‘ব্যবহৃত’ শব্দের যুক্তবর্ণ ‘হৃ’, গঠিত হ্ + ঋ দিয়ে। ঋ-কার (ৃ) হ-এর সঙ্গে মিলে ‘হৃ’ রূপ নেয়। কাছাকাছি আরও যুক্তরূপ: হু (হ্ আর উ), হ্ন, হ্ম, ণ্ড, ঙ্গ। যুক্ত বর্ণগুলো কখনো স্পষ্ট (স্বচ্ছ), কখনো অস্পষ্ট (অস্বচ্ছ) দেখায়; ‘হৃ’ অস্বচ্ছ উদাহরণ।","id":"q24787c62fe","t":"l","s":""},{"q":"নিচের কোনগুলো তালব্য বর্ণ?","o":["ল,স","শ, ঝ","ড়, ঢ়","ভ, ফ"],"a":1,"e":"","id":"q2482a7d140","t":"l","s":""},{"q":"বাংলাভাষার বর্ণমালায় মাত্রাহীন বর্ণ কয়টি?","o":["৭ টি","১০ টি","৮ টি","১২ টি"],"a":1,"e":"","id":"q2494ca439f","t":"l","s":""},{"q":"'ব্রাহ্মণ' শব্দের যুক্তবর্ণে কোন দুটি বর্ণ যুক্ত রয়েছে?","o":["হ + ম","ক + ষ","ম + হ","ক + ম"],"a":0,"e":"","id":"q249be63ae5","t":"l","s":""},{"q":"নিম্নবিবৃত স্বরধ্বনি —","o":["অ","অ্যা","আ","ই"],"a":2,"e":"","id":"q24e7d50ad6","t":"l","s":""},{"q":"”অ্যা” কী ধরনের স্বরধ্বনি?","o":["অর্ধ-সংবৃত","সংবৃত","বিবৃত","অর্ধ-বিবৃত"],"a":3,"e":"","id":"q2521cbde15","t":"l","s":""},{"q":"কোনটি পশ্চাৎ স্বরধ্বনি নয়?","o":["ই","উ","ও","অ"],"a":0,"e":"","id":"q2621a40988","t":"l","s":""},{"q":"উ, ঊ ও অ-ধ্বনিকে কী ধরনের স্বরধ্বনি বলা হয়?","o":["মধ্য স্বরধ্বনি","পশ্চাৎ স্বরধ্বনি","নিম্ন স্বরধ্বনি","সম্মুখ স্বরধ্বনি"],"a":1,"e":"","id":"q266fa375ef","t":"l","s":""},{"q":"মাত্রাহীন স্বরবর্ণ নয় কোনটি?","o":["ঐ","এ","ঋ","ঔ"],"a":2,"e":"","id":"q