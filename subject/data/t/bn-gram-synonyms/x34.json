[{"q":"'ঊর্মি' শব্দের সমার্থক কোনটি?","o":["সোজা","বাতাস","ঢেউ","আলো"],"a":2,"e":"<p>ঊর্মি মানে ঢেউ বা তরঙ্গ। ঢেউয়ের আরও সমার্থক তরঙ্গ, লহরী, বীচি ও হিল্লোল। অপশনের সোজা, বাতাস বা আলোর সঙ্গে ঊর্মির অর্থগত কোনো সম্পর্ক নেই। ঢেউ বাতাসে তৈরি হলেও বাতাসের সমার্থক হলো বায়ু, পবন, সমীর, অনিল। ঊর্মিমালা মানে ঢেউয়ের সারি, আর প্রমিত বানানে শব্দটি দীর্ঘ ঊ দিয়ে লেখা হয়।</p>","id":"qdff3b4cf20","t":"x","s":""},{"q":"'শুদ্ধ' শব্দের সমার্থক শব্দ কোনটি?","o":["শান্ত","ভদ্র","শুশীল","কোনটিই নয়"],"a":3,"e":"","id":"qe06a50a55f","t":"x","s":""},{"q":"'ফুলেল বন্দনা'র সমার্থক শব্দবন্ধ কোনটি?","o":["বাসন্তী লতা","পুষ্পারতি","অঞ্জলি","অর্ঘ্য বিরচন"],"a":1,"e":"","id":"qe08b826f2c","t":"x","s":""},{"q":"'অরুণ' শব্দটির সমার্থক শব্দ কোনটি?","o":["অপূর্ব","অক্লিষ্ট","তাজ্জব","আরক্ত"],"a":3,"e":"","id":"qe09362b093","t":"x","s":""},{"q":"'জাঙ্গাল' এর প্রতিশব্দ-","o":["আবর্জনা","জঙ্গল","স্তূপ","বাঁধ"],"a":3,"e":"","id":"qe0a7a3eb7c","t":"x","s":""},{"q":"‘অটবী' শব্দের সমার্থক শব্দ কোনটি?","o":["কুল","বন","নদী","সমুদ্র"],"a":1,"e":"","id":"qe0f70701f7","t":"x","s":""},{"q":"‘রাত্রি’-এর সমার্থক শব্দ নয়-","o":["রজনী","শর্বরী","যামিনী","বারিদ"],"a":3,"e":"","id":"qe104e05efc","t":"x","s":""},{"q":"'বিদ্যুৎ' শব্দের সমার্থক কোনটি?","o":["প্রভাকর","ক্ষণপ্রভা","অনল","সুধাকর"],"a":1,"e":"","id":"qe208204483","t":"x","s":""},{"q":"'কিরণ' শব্দের সমার্থক শব্দ কোনটি?","o":["তনয়া","অক্ষমা","অংশু","পরভৃত"],"a":2,"e":"কিরণ মানে আলোর রশ্মি; এর সমার্থক অংশু, রশ্মি, প্রভা ইত্যাদি। তনয়া মানে কন্যা আর পরভৃত মানে কোকিল।","id":"qe231ad6ed6","t":"x","s":"প্রাথমিক শিক্ষা অধিদপ্তর, প্রাক-প্রাথমিক সহকারী শিক্ষক (সুরমা) (২০১৩)"},{"q":"'আকাশ' এই শব্দটির প্রতিশব্দ কোনগুলো?","o":["ধরিত্রী, মহী, মেদিনী","ব্যোম, অন্তরীক্ষ, শূন্য","অলক, কুন্তল, চিকুর","অনল, পাবক, বহ্নি"],"a":1,"e":"","id":"qe31f2c56d9","t":"x","s":""},{"q":"'পদ্ম'-এর সমার্থক শব্দ কোনটি?","o":["অরবিন্দ","জলধর","অঞ্জন","মনসিজ"],"a":0,"e":"","id":"qe39161bede","t":"x","s":""},{"q":"কোনটি অগ্নি শব্দের সমার্থক শব্দ নয়?","o":["মার্তণ্ড","পাবক","হুতাশন","সর্বভুক"],"a":0,"e":"","id":"qe3a1935fa1","t":"x","s":""},{"q":"'সমুদ্র' শব্দের সমার্থক নয় কোনটি?","o":["বারিধি","সিন্ধু","তরঙ্গ","সাগর"],"a":2,"e":"বারিধি, সিন্ধু ও সাগর সমুদ্রের সমার্থক। 'তরঙ্গ' মানে ঢেউ, যা সমুদ্রে থাকলেও সমুদ্রের প্রতিশব্দ নয়।","id":"qe3c51e3760","t":"x","s":"বাংলাদেশ জুডিশিয়াল সার্ভিস কমিশন, সহকারী জজ (৩য় বিজেএস প্রিলিমিনারি) (২০০৮)"},{"q":"'কূল' শব্দের প্রতিশব্দ নয়-","o":["তট","তীর","কুন্তল","অবধি"],"a":2,"e":"","id":"qe3d9d0f4cd","t":"x","s":""},{"q":"'সূর্য' এর সমার্থক শব্দ নয় কোনটি?","o":["মিহির","অবনী","সবিতা","আদিত্য"],"a":1,"e":"","id":"qe414c58a03","t":"x","s":""},{"q":"কোনটি সমার্থক নয়?","o":["ঐতিহ্য-বিশ্রুতি","অহ্ন-শর্বরী","অনল-পাবক","অম্বর-নীলিমা"],"a":1,"e":"","id":"qe5b3a6c2a1","t":"x","s":""},{"q":"'আকাশ' এর প্রতিশব্দ কী?","o":["অসীম","গগন","কানন","কিরণ"],"a":1,"e":"<p>আকাশের প্রতিশব্দ গগন। আকাশের আরও প্রচলিত সমার্থক অম্বর, নভ, নভোমণ্ডল, ব্যোম, অন্তরীক্ষ ও মেঘলোক। অসীম মানে সীমাহীন, আকাশের একটি বৈশিষ্ট্য হলেও প্রতিশব্দ নয়। কানন মানে বন বা বাগান, আর কিরণ মানে আলোর রশ্মি। অম্বর শব্দটির আরেক অর্থ বস্ত্র, তাই অম্বর দ্ব্যর্থক শব্দ হিসেবেও প্রশ্নে আসে।</p>","id":"qe8f6bba855","t":"x","s":""},{"q":"'সিংহ' শব্দের সমার্থক শব্দ-","o":["ভুজ","শুক্ল","মৃগেন্দ্র","পানি"],"a":2,"e":"","id":"qe9125eaa53","t":"x","s":""},{"q":"‘ঢেউ’ শব্দের প্রতিশব্দ কোনটি?","o":["বারি","অম্বু","বীচি","বারিধি"],"a":2,"e":"'বীচি' মানে ঢেউ বা তরঙ্গ। বারি ও অম্বু মানে পানি, আর বারিধি মানে সমুদ্র।","id":"qe9edba1a37","t":"x","s":"প্রাথমিক শিক্ষা অধিদপ্তর, সহকারী শিক্ষক (সুরমা) (২০১০)"},{"q":"'নন্দন' শব্দের সমার্থক শব্দ-","o":["আদিত্য","শৈল","পুত্র","হিমাংশু"],"a":2,"e":"","id":"qea2a28cb6a","t":"x","s":""}]
