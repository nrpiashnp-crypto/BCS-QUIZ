[{"q":"'তট' শব্দটির সমার্থক শব্দ কোনটি?","o":["অম্বু","বহ্নি","পাবক","কূল"],"a":3,"e":"","id":"q1aed80f1f0","t":"l","s":""},{"q":"‘আনন্দ’ শব্দের সমার্থক শব্দ কোনটি?","o":["ঠাট্টা","পুলক","দীপ্তি","পুলিন"],"a":1,"e":"সঠিক উত্তর পুলক। আনন্দের সমার্থক শব্দ খুশি, হর্ষ, আহ্লাদ, আমোদ, প্রমোদ, উল্লাস, পুলক ইত্যাদি। অন্য বিকল্পের অর্থ আলাদা: ঠাট্টা মানে উপহাস বা বিদ্রুপ, দীপ্তি মানে আলোর ছটা, পুলিন মানে নদীর তীর বা বালুকাময় তট। 'পুলক' শব্দের আরেক অর্থ রোমাঞ্চ।","id":"q1cea2583dd","t":"l","s":""},{"q":"'কপাল' শব্দের প্রতিশব্দ কোনটি?","o":["ললাট","জ্যোতি","শিখা","তালাশ"],"a":0,"e":"","id":"q1ebda7ccfd","t":"l","s":""},{"q":"'বসুমতি' শব্দের সমার্থক কোনটি?","o":["গিরি","ফুল","পৃথিবী","কানন"],"a":2,"e":"","id":"q1f4fb8cd9d","t":"l","s":""},{"q":"'পর্ণী' শব্দের সমার্থক শব্দ কোনটি?","o":["হাত","গাছ","পানি","মেঘ"],"a":1,"e":"","id":"q1f521e5dfb","t":"l","s":""},{"q":"'ঊষা' শব্দের সমার্থক শব্দ কোনটি?","o":["প্রত্যুষ","গোধূলি","সায়াহ্ন","মধ্যাহ্ন"],"a":0,"e":"ঊষা হলো সূর্যোদয়ের আগের আলো ফোটার সময়, অর্থাৎ ভোর। প্রত্যুষ শব্দেরও এই একই অর্থ। বাকি শব্দগুলো দিনের অন্য সময়কে বোঝায়; গোধূলি ও সায়াহ্ন সন্ধ্যার সময়, আর মধ্যাহ্ন দুপুর।\nমনে রাখুন:\nভোর = ঊষা, প্রত্যুষ, প্রভাত, অরুণোদয়\nদুপুর = মধ্যাহ্ন, দ্বিপ্রহর","id":"q1f88e881f7","t":"l","s":""},{"q":"'পল্লবী' শব্দের সমার্থক শব্দ কোনটি?","o":["নদী","কন্যা","গাছ","কামিনী"],"a":2,"e":"","id":"q246759d433","t":"l","s":""},{"q":"‘আগার’ শব্দের সমার্থক-","o":["নদী","পর্বত","শ্যাওলা","গৃহ","ঘোড়া"],"a":3,"e":"","id":"q24e179f49f","t":"l","s":""},{"q":"অভ্র","o":["সাদা","ভ্রমর","মেঘ","পাহাড়","কোনোটিই নয়"],"a":2,"e":"","id":"q2663b056f6","t":"l","s":""},{"q":"নিচের কোনটি 'অনল' এর প্রতিশব্দ নয়?","o":["বহ্নি","সর্বভুক","বিভাবসু","পবন","সবগুলোই প্রতিশব্দ"],"a":3,"e":"","id":"q26a7200bf2","t":"l","s":""},{"q":"‘দ্রুম’ শব্দের সমার্থক শব্দ কোনটি?","o":["পর্বত","বৃক্ষ","পাথর","বন"],"a":1,"e":"","id":"q26cf45e007","t":"l","s":""},{"q":"'যুদ্ধ' শব্দের সমার্থক শব্দ কোনটি?","o":["নিধন","বিগ্রহ","নাশ","আশীবিষ"],"a":1,"e":"","id":"q28be326a59","t":"l"