[{"q":"log₅ ∛5 এর মান কত?","o":["1/2","5","1/5","3/2"],"a":3,"e":"","id":"qb7a4501817","t":"l","s":""},{"q":"log x 1/64 = -6 হলে, x = ?","o":["0","1","2","3"],"a":2,"e":"","id":"qb849706f8f","t":"l","s":""},{"q":"A = {0, 2, 3, 7, 9} B = {1, 5, 6, 8, 11), С = {2, 5, 7, 8, 12, 14} হলে, (A ∩ B) ∪ (A ∩ C) এর মান কত?","o":["{4, 7, 9}","{0, 2, 4, 7}","{2, 3, 5, 7, 9}","{2, 7}"],"a":3,"e":"","id":"qb8686da186","t":"l","s":""},{"q":"log₃5 × log₅9 এর মান কত?","o":["1","5","45","2"],"a":3,"e":"ভিত্তি পরিবর্তনের নিয়মে log₃5 = (log 5)/(log 3) এবং log₅9 = (log 9)/(log 5)। গুণ করলে log 5 কাটা যায় এবং থাকে (log 9)/(log 3) = log₃9। আর 9 = 3^2, তাই log₃9 = 2।\nমনে রাখুন:\nlog_a b × log_b c = log_a c\nlog_a b = (log b)/(log a)","id":"qb95676ff81","t":"l","s":""},{"q":"log 5 (1/625) = কত?","o":["4","- 5","- 4","5"],"a":2,"e":"","id":"qb997b3b4cc","t":"l","s":""},{"q":"if log 10 7 = a, then log 10 (1/70) is equal to......","o":["-(1 - a)","-(1+a)","(1 - a)","(1+a)"],"a":1,"e":"","id":"qb9a950d4e5","t":"l","s":""},{"q":"নিচের কোন সম্পর্কটি ভুল?","o":["log 10 1 = 0","log a (M/N) = log a M - log a N","log(2 + 3) = log(2 × 3)","log 10 10 = 1"],"a":2,"e":"","id":"qba110c8f17","t":"l","s":""},{"q":"log x (5/2) = - 1/2 হলে x এর মান কত?","o":["√(5/2)","4/25","√(2/5)","25/4"],"a":1,"e":"","id":"qba11243dcb","t":"l","s":""},{"q":"log 2 (log 3 (log 4 x)) = 0 হলে, √x-এর মান কত?","o":["64","16","6","8"],"a":3,"e":"","id":"qba6cd615cf","t":"l","s":""},{"q":"log 2 √20 + log 2 √(4/5) = কত?","o":["1/4","2","1","0"],"a":1,"e":"","id":"qbb5eb4570c","t":"l","s":""},{"q":"If √3 n = 729, then the value of n is ?","o":["12","9","15","6"],"a":0,"e":"729 = 3⁶। দুই পক্ষের বর্গ নিলে বর্গমূল কেটে যায়: 3ⁿ = 3¹²। ভিত্তি সমান হলে সূচকও সমান, তাই n = 12।","id":"qbbb9c9dc2f","t":"l","s":""},{"q":"log x (3/2) = -1/2 হলে, x =?","o":["4/9","2/9","1/9","25/16"],"a":0,"e":"","id":"qbbbcef3b67","t":"l","s":""},{"q":"log a p = 2, log a q = 3, log a r = 4 হলে, log a {(p 2 q 2 )/r} এর মান কত?","o":["2","6","4","8"],"a":1,"e":"","id":"qbbe74b7c81","t":"l","s":""},{"q":"If log(a/b)+log(b/a) = log(a+b), then","o":["a + b = 1","a - b = 1","a = b","None of them"],"a":0,"e":"","id":"qbc7a232aec","t":"l","s":""},{"q":"সরল করুনঃ (log √27 + log8 - log √1000) ÷ log1.2","o":["1/3","1/2","3/2","1"],"a":2,"e":"","id":"qbc90f8c1a4","t":"l","s":""},{"q":"log a 1/27 = 3 হলে, a এর মান কত?","o":["- 3","0","1/3","1"],"a":2,"e":"","id":"qbc9d425518","t":"l","s":""},{"q":"log 32 x = 0.8 হলে x এর মান কত?","o":["12","16","14","8"],"a":1,"e":"","id":"qbcabddc3c9","t":"l","s":""},{"q":"log 10 (x - 1) + log 10 (x + 1) = log 2 1 হলে, x এর মান নির্ণয় করুন।","o":["1/2","2","√2","0"],"a":2,"e":"","id":"qbcf5789db6","t":"l","s":""},{"q":"যদি log 8 x = 2/3 হয়, তবে x এর মান কত?","o":["4/5","1/4","3/4","4"],"a":3,"e":"","id":"qbd5dafd438","t":"l","s":""},{"q":"log 2 8 + log 2 32 + log 2 128 = কত?","o":["12","16","15","18"],"a":2,"e":"","id":"qbd9b35503c","t":"l","s":""}]
