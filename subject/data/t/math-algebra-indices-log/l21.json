[{"q":"3 a ÷ 3 a - 1 = কত?","o":["1/3","1","3","3 2a"],"a":2,"e":"","id":"q67482af870","t":"l","s":""},{"q":"A = {x ∈ N : x 2 > 6, x 3 < 20} হলে, x এর মান কত?","o":["{2, 4}","{4}","{3}","{}"],"a":3,"e":"","id":"q67ac88ee6d","t":"l","s":""},{"q":"x 0 + y 0 + z 1 এর মান কত?","o":["z","1","3","2 + z"],"a":3,"e":"","id":"q67ada754b0","t":"l","s":""},{"q":"5 3x - 2 = 625, find the value of x.","o":["2","3","1","0"],"a":0,"e":"625 = 5⁴ হওয়ায় সমীকরণটি 5^(3x − 2) = 5⁴ হয়। ভিত্তি সমান হলে ঘাত সমান: 3x − 2 = 4, তাই 3x = 6 এবং x = 2।","id":"q67e3379a30","t":"l","s":""},{"q":"log 2 log √e e 4 = ?","o":["2","3","4","- 3"],"a":1,"e":"","id":"q686461caea","t":"l","s":""},{"q":"log x 3/4 = - 1/2 হলে x এর মান কত?","o":["256/81","81/256","9/16","16/9"],"a":3,"e":"","id":"q6882fdd4c4","t":"l","s":""},{"q":"16 {n - (1/2)} = 64 হলে, n এর মান কত?","o":["1","2","- 4","3"],"a":1,"e":"","id":"q691dd48879","t":"l","s":""},{"q":"4 x + 2 = 2 2x + 1 + 14 , Find the value of x.","o":["1","4","2","0"],"a":3,"e":"4^(x + 2) = 16 · 4^x এবং 2^(2x + 1) = 2 · 4^x। এভাবে সমীকরণ হয় 16 · 4^x = 2 · 4^x + 14, অর্থাৎ 14 · 4^x = 14। তাই 4^x = 1 = 4⁰, ফলে x = 0।","id":"q6930192566","t":"l","s":""},{"q":"(√5 + 1)x + 4 = 4√5 হলে x এর মান কত?","o":["5 - √5","1 - √5","4 - 3√5","6 - 2√5"],"a":3,"e":"","id":"q697da38d20","t":"l","s":""},{"q":"If 5 a = 125, then 5 a - 3 =?","o":["1","0","2","3"],"a":0,"e":"5^a = 125 = 5³ থেকে a = 3। তখন 5^(a - 3) = 5⁰ = 1। বিকল্প পথ: 5^(a-3) = 5^a ÷ 5³ = 125/125 = 1।","id":"q698e337d76","t":"l","s":""},{"q":"a = 1 + √2 হলে a 3 = কত?","o":["3 + 4√2","21√2","7 + 5√2","8√2"],"a":2,"e":"","id":"q69907cf5ea","t":"l","s":""},{"q":"যদি 4 √x 3 = 2 হয়, তাহলে x 3/2 =?","o":["8","64","4","16"],"a":2,"e":"<p>প্রশ্নটি হলো ⁴√(x³) = ২।<br>⁴√(x³) = x^(৩/৪), তাই x^(৩/৪) = ২<br>এখন x^(৩/২) = x^(৩/৪ × ২) = (x^(৩/৪))²<br>= ২² = ৪<br>যাচাই: x^(৩/৪) = ২ হলে x = ২^(৪/৩), তখন x^(৩/২) = ২^(৪/৩ × ৩/২) = ২² = ৪।<br>উত্তর ৪। ৮ পাওয়া যায় ২-এর ঘন করলে, ১৬ পাওয়া যায় ২-এর চতুর্থ ঘাত নিলে, আর ৬৪ আরও বড় ভুল ঘাত থেকে আসে। শর্টকাট: প্রদত্ত সূচক ৩/৪ আর চাওয়া সূচক ৩/২ তার দ্বিগুণ, তাই উত্তর ২²।</p>","id":"q69c7cd5e86","t":"l","s":""},{"q":"যদি log x 144 = 4 হয়, তবে x এর মান কত?","o":["3√2","2√5","2√3","4"],"a":2,"e":"","id":"q6a44b8ea9f","t":"l","s":""},{"q":"log 3 (√27) + log 3 (√(1/3)) = কত?","o":["4","1","5","- 3"],"a":1,"e":"","id":"q6a743b49d7","t":"l","s":""},{"q":"log 3 log 2 log 3 x = 0 হলে x = কত?","o":["4","3","9","1"],"a":2,"e":"","id":"q6a8156bc46","t":"l","s":""},{"q":"U = {1, 2, 3, 4, 5, 7} এবং A= {1, 2, 5, 6} হলে A' এর মান কত?","o":["{3, 4, 7}","{2, 4, 5}","{3, 5, 6}","{1, 4, 7}"],"a":0,"e":"","id":"q6ae45ffc92","t":"l","s":""},{"q":"(2 5 × 2 3 )/2 4 ​-এর মান কত?","o":["32","16","12","8"],"a":1,"e":"","id":"q6be788cbd4","t":"l","s":""},{"q":"4 x + 2 = 64 হলে x-এর মান কত?","o":["2","1","3","0"],"a":1,"e":"","id":"q6c9aded5ec","t":"l","s":""},{"q":"log 16 x = 0.125 হলে, x এর মান কত?","o":["√2","2","√3","1/2"],"a":0,"e":"","id":"q6d6ee61930","t":"l","s":""},{"q":"The value of (32) 0.08 × (32) 0.12 is -","o":["4","2","6","3"],"a":1,"e":"একই ভিত্তির গুণে ঘাত যোগ হয়, তাই 32^0.08 × 32^0.12 = 32^(0.08 + 0.12) = 32^0.2। 32 = 2^5 হওয়ায় (2^5)^(1/5) = 2^1 = 2।","id":"q6da4098162","t":"l","s":""}]
