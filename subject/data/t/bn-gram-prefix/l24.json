[{"q":"বিফল শব্দটি কোন উপসর্গযোগে গঠিত হয়েছে?","o":["বাংলা","তৎসম","আরবি","ফারসি"],"a":1,"e":"সঠিক উত্তর তৎসম। বাংলা ও সংস্কৃত দুই ভাষায় চলে এমন উপসর্গের (আ, সু, বি, নি) ক্ষেত্রে মূল শব্দ কোন ভাষার, তা দেখতে হয়। বিফল শব্দে 'ফল' তৎসম শব্দ, তাই 'বি' উপসর্গও তৎসম ধরা হয়।","id":"qd3517dfdb6","t":"l","s":""},{"q":"নিচের কোনটি আরবি উপসর্গ?","o":["পাতি","গর","রাম","পরা"],"a":1,"e":"আরবি উপসর্গ ‘গর’ (যেমন গরহাজির, গরমিল)। বিদেশি উপসর্গ সংখ্যায় বাঁধা নয়; এর নমুনা:\n• আরবি: আম, খাস, লা, গর, বাজে, খয়ের।\n• ফারসি: বে, বদ, নিম, ফি, কম, কার, দর ইত্যাদি।\n• উর্দু: হর।\n• ইংরেজি: হেড, সাব, ফুল, হাফ।\nঅপশনের অন্য শব্দ:\n• পাতি ও রাম: খাঁটি বাংলা উপসর্গ (পাতিহাঁস, রামছাগল)।\n• পরা: তৎসম বা সংস্কৃত উপসর্গ (পরাজয়)।","id":"qd506dd6a9a","t":"l","s":""},{"q":"'নিখুঁত' শব্দে 'নি' উপসর্গটি কোন ধরনের?","o":["খাঁটি বাংলা","ফারসি","তৎসম","আরবি"],"a":0,"e":"","id":"qd562446a38","t":"l","s":""},{"q":"কোনটি তৎসম উপসর্গ?","o":["আড়","অঘা","পাতি","অপ"],"a":3,"e":"","id":"qd5715f07c3","t":"l","s":""},{"q":"অশুভ অর্থে ‘অনা’ উপসর্গটি ব্যবহৃত হয়েছে কোন শব্দে?","o":["অনাদায়","অনামুখে","অনাচার","অনাসৃষ্টি"],"a":1,"e":"","id":"qd5a6f44937","t":"l","s":""},{"q":"'পাতিহাঁস' শব্দটিতে 'পাতি' উপসর্গটি কী অর্থ প্রকাশ করে?","o":["ক্ষুদ্র","বিপ্সা","তুলনা","বৃহৎ"],"a":0,"e":"","id":"qd5a88341d4","t":"l","s":""},{"q":"'হররোজ' কোন ধরনের উপসর্গ?","o":["উর্দু- হিন্দি উপসর্গ","তৎসম উপসর্গ","ফারসি উপসর্গ","বাংলা উপসর্গ"],"a":0,"e":"","id":"qd5c205e038","t":"l","s":""},{"q":"'পাতিহাঁস' শব্দের ‘পাতি’ উপসর্গটি কোন ধরনের উপসর্গ?","o":["আরবি","তৎসম","ফারসি","বাংলা"],"a":3,"e":"","id":"qd60c0644a7","t":"l","s":""},{"q":"নিচের কোনটি খাঁটি বাংলা উপসর্গ?","o":["দুর","আড়","সম","পরা"],"a":1,"e":"","id":"qd6d9c850db","t":"l","s":""},{"q":"কোন দুটি বাংলা উপসর্গ?","o":["অনু, অব","আব, ইতি","দুর, বি","সু, উৎ"],"a":1,"e":"","id":"qd7191d7cec","t":"l","s":""},{"q":"নিচের কোনগুলো বাংলা উপসর্গ?","o":["ফি, নিম, বে","রাম, ইতি, পাতি","উপ, অপি, অভি","অপ, সম, অনু"],"a":1,"e":"","id":"qd726b5ba56","t":"l","s":""},{"q":"'উত্তপ্ত’ শব্দ