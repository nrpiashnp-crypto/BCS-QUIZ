[{"q":"নিচের কোনটি উপসর্গজাত শব্দ নয়?","o":["উপদেশ","নীলাম্বর","অফুরন্ত","অশেষ"],"a":1,"e":"","id":"q4ca3dcbf8a","t":"x","s":""},{"q":"'বিনির্মাণ' শব্দের 'বি' উপসর্গটি কী অর্থে ব্যবহৃত হয়েছে?","o":["ইতিবাচক","নতুন","নেতিবাচক","প্রসারণ"],"a":0,"e":"","id":"q4d56e8ccb9","t":"x","s":""},{"q":"নিচের কোন শব্দের উপসর্গটি 'নিকৃষ্ট' অর্থে ব্যবহৃত হয়েছে?","o":["পরাভব","অপকর্ম","অপমান","উপভোগ"],"a":1,"e":"","id":"q4e0553c76e","t":"x","s":""},{"q":"নিচের কোনটি ফারসি উপসর্গ সহযোগে গঠিত শব্দ?","o":["বদনাম","হররোজ","খাসমহল","গরমিল","কোনোটিই নয়"],"a":0,"e":"‘বদনাম’ = বদ + নাম। এখানে ‘বদ’ একটি ফারসি উপসর্গ, যার অর্থ মন্দ বা খারাপ, যেমন বদমেজাজ, বদহজম। বাকি তিনটি অন্য ভাষার উপসর্গে গঠিত: ‘হররোজ’-এর ‘হর’ (প্রতি) উর্দু-হিন্দি উপসর্গ, আর ‘খাসমহল’-এর ‘খাস’ ও ‘গরমিল’-এর ‘গর’ আরবি উপসর্গ। বাংলা ভাষায় সংস্কৃত উপসর্গের পাশাপাশি এভাবে ফারসি, আরবি ও উর্দু উপসর্গও চলে আসে।<br>মনে রাখুন:<br>ফারসি উপসর্গ: কার, দর, না, নিম, ফি, বদ, বে, বর, ব, কম।<br>আরবি উপসর্গ: আম, খাস, লা, গর।<br>উর্দু-হিন্দি উপসর্গ: হর।<br>ফারসি উপসর্গযুক্ত শব্দের উদাহরণ: বেহুঁশ, নাপাক, ফি-বছর, কমজোর, দরদালান।","id":"q4f975dc56b","t":"x","s":"বিসিআইসি, সহকারী ব্যবস্থাপক (প্রশাসন) (২০২২)"},{"q":"প্র, পরা, অপ কোন শ্রেণির উপসর্গ?","o":["বাংলা উপসর্গ","সংস্কৃত উপসর্গ","উপসর্গ স্থানীয় ভাষা","বিদেশি উপসর্গ","কোনোটিই নয়"],"a":1,"e":"","id":"q4fda580273","t":"x","s":""},{"q":"'অনামুখো' শব্দের 'অনা' উপসর্গ কোন অর্থে ব্যবহৃত?","o":["বক্র","অশুভ","অভাব","ব্যতীত"],"a":1,"e":"","id":"q500c059a0d","t":"x","s":""},{"q":"'পরাভব' শব্দে 'পরা' উপসর্গটি কি অর্থে ব্যবহৃত হয়েছে?","o":["বিবৃত","অভাব","আধিক্য","বিপরীত"],"a":3,"e":"","id":"q519a5f7b05","t":"x","s":""},{"q":"কোনটি উপসর্গযোগে গঠিত শব্দ নয়?","o":["হররোজ","হরহামেশা","হরদম","হরতাল"],"a":3,"e":"","id":"q51a5c1b0d4","t":"x","s":""},{"q":"'গরহাজির' শব্দে 'গর' কোন শ্রেণির উপসর্গ?","o":["উর্দু","ফারসি","হিন্দি","আরবি"],"a":3,"e":"","id":"q556e3307e6","t":"x","s":""},{"q":"'সুনাম' এর 'সু' কোন উপসর্গ?","o":["সংস্কৃত","ফারসি","বাংলা","আরবি"],"a":2,"e":"","id":"q55e81c5e2a","t":"x","s":""}