[{"q":"১ + ৩ + ৫ + ........... + ২৫ = কত?","o":["১৮৯","৩৪৭","২১০","১৬৯"],"a":3,"e":"","id":"q1259bbdeef","t":"l","s":""},{"q":"কোনো ধারার প্রথম n সংখ্যক পদের সমষ্টি n(n + 1) হলে, ধারাটির প্রথম 15 টি পদের সমষ্টি কত?","o":["320","420","280","240"],"a":3,"e":"","id":"q12ae70380d","t":"l","s":""},{"q":"(1/4) - (1/6) + (1/9) - (2/7) + ………. ধারাটির সাধারণ অনুপাতের ক্ষেত্রে কোনটি সঠিক হবে?","o":["সাধারণ অনুপাত ০ অপেক্ষা বড় হবে","সাধারণ অনুপাত ধনাত্মক হবে","সাধারণ অনুপাত 1 অপেক্ষা বড় হবে","সাধারণ অনুপাত ০ অপেক্ষা ছোট হবে"],"a":3,"e":"","id":"q1345975a89","t":"l","s":""},{"q":"3 + 6 + 12 + 24 + …... ধারাটির 9ম পদ কত?","o":["768","1296","384","1536"],"a":0,"e":"","id":"q138eea6509","t":"l","s":""},{"q":"7 + (7/2) + (7/4) + (7/8) + ...... ধারাটির অসীমতক পদের সমষ্টি কত?","o":["1/2","21","1/7","14"],"a":3,"e":"","id":"q139963a526","t":"l","s":""},{"q":"1 2 + 2 2 + 3 2 + 4 2 + ......+(n - 1) 2 =?","o":["n (n - 1) (2n - 1)/6","n(n + 1)/2","n(n + 1)(2n + 1)/6","n(n + 1)(2n + 1)/2"],"a":0,"e":"","id":"q13edc6d936","t":"l","s":""},{"q":"In an AP, the ratio of the 2nd term to the 7th term is 1/3. If the 5th term is 11, what is the 15th term?","o":["31","28","36","33"],"a":0,"e":"(a + d)/(a + 6d) = 1/3 থেকে 3a + 3d = a + 6d, তাই 2a = 3d। 5ম পদ a + 4d = 11 হওয়ায় 3d/2 + 4d = 11, ফলে d = 2 ও a = 3। 15-তম পদ = 3 + 14 × 2 = 31।","id":"q14dfdc5d78","t":"l","s":""},{"q":"কোন গুণোত্তর ধারার তৃতীয় পদ 6 হলে, প্রথম 5 টি পদের গুনফল কত?","o":["7771","7776","7737","7171"],"a":1,"e":"","id":"q15ec904267","t":"l","s":""},{"q":"1 + 1/3 + 1/9 + .... ধারাটির কততম পদের মান 1/729?","o":["8","9","6","7"],"a":3,"e":"","id":"q15eea2bfc8","t":"l","s":""},{"q":"1/√2, 1, √2,..... ধারাটির কোন পদ 8 হবে?","o":["6","9","7","8"],"a":3,"e":"","id":"q16162a3481","t":"l","s":""},{"q":"The 6th term of an AP is 6 and the 16th term is 14. What is the 27th term?","o":["106/5","118/5","114/5","22/5"],"a":2,"e":"a + 5d = 6 এবং a + 15d = 14। বিয়োগ করলে 10d = 8, তাই d = 4/5। তখন a = 6 − 4 = 2। 27-তম পদ = a + 26d = 2 + 104/5 = 114/5। যাচাই: d = 4/5 হলে 6-তম পদ 2 + 5 × 4/5 = 6 এবং 16-তম পদ 2 + 15 × 4/5 = 14, দুটিই শর্তের সাথে মেলে। সমান্তর ধারায় n-তম পদ = a + (n − 1)d।","id":"q1656351689","t":"l","s":""},{"q":"5 + 9 + 13 + 17 +.......... ধারাটির 90 তম পদ কত?","o":["361","391","421","341"],"a":0,"e":"","id":"q165f560589","t":"l","s":""},{"q":"একটি ধারার n তম পদ n.2 n+1 হলে ধারাটির ১ম চারটি পদের সমষ্টি কত?","o":["196","148","192","129"],"a":0,"e":"","id":"q169185f16a","t":"l","s":""},{"q":"কোনো সমান্তর ধারার প্রথম পদ 8 এবং দ্বিতীয় পদ 13 হলে, ধারাটির প্রথম 15টি পদের সমষ্টি কত?","o":["615","645","715","725"],"a":1,"e":"","id":"q16bf3dbdf1","t":"l","s":""},{"q":"a+ar+ar²+ar³+…………. গুনোত্তর ধারাটির অসীমতক সমষ্টি কত, যখন ।r। < 1","o":["a/1-r","a1-r/r","a/r","a/r+1"],"a":0,"e":"","id":"q17936cc8ba","t":"l","s":""},{"q":"একটি ধারার n তম পদ m ( n + 2) । যদি তৃতীয় পদ 243 হয়, তবে m এর মান কত?","o":["3","1","2","0"],"a":0,"e":"","id":"q17cf2c4739","t":"l","s":""},{"q":"3 + 6 + 12 + 24 + ....… ধারার n সংখ্যক পদের সমষ্টি 765 হলে, n এর মান কত?","o":["12","9","8","7"],"a":2,"e":"","id":"q17dd34a041","t":"l","s":""},{"q":"একটি সমান্তর ধারার সাধারণ অন্তর 6 এবং 8ম পদ 47 হলে, 25তম পদ কত?","o":["143","155","149","139"],"a":2,"e":"","id":"q17e09cbdfd","t":"l","s":""},{"q":"5 + 1 + 0.2 + 0.04 +…............ ধারাটির অসীম পর্যন্ত যোগফল কত?","o":["25/4","1/4","3/10","2/5"],"a":0,"e":"","id":"q17e960082a","t":"l","s":""},{"q":"13 + 19 + 25 + 31 + ...... ধারাটির 13 তম পদ কত?","o":["79","97","91","85"],"a":3,"e":"","id":"q17fe877615","t":"l","s":""}]
