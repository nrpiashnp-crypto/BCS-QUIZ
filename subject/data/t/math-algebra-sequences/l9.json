[{"q":"3 + 4 + 5 + 6 + ......+ 101 = ?","o":["5149","5151","5148","5150"],"a":2,"e":"","id":"q0fee1b8930","t":"l","s":""},{"q":"3 + 6 + 12 + 24 + .................. ধারাটির n সংখ্যক পদের সমষ্টি 3069 হলে, n এর মান কত?","o":["10","8","9","6"],"a":0,"e":"","id":"q10e86dbf9e","t":"l","s":""},{"q":"log2+log4+log8+………………… ধারাটির প্রথম দশম পদের সমষ্টি কত?","o":["50log2","60log2","55log2","65l0g2"],"a":2,"e":"","id":"q10f11503e9","t":"l","s":""},{"q":"একটি গুণোত্তর ধারার প্রথম পদ 1/√2 এবং সাধারণ অনুপাত√2 হলে, ধারাটির কোন পদটি 16√2?","o":["9তম","10তম","11তম","13তম"],"a":2,"e":"","id":"q110f0de689","t":"l","s":""},{"q":"একটি গুণোত্তর ধারার ২য় পদ 9 এবং অষ্টম পদ 1/81 হলে, সাধারণ অনুপাত কত?","o":["1/2","1/3","1/4","1/9"],"a":1,"e":"","id":"q114e43d0a4","t":"l","s":""},{"q":"কোনটি গুণোত্তর ধারা নয়?","o":["২ + ৪ + ৮ + ...........","২ + ৫ + ৮ + .....................","১/২ + ১/৪ + ১/৮ + ................","৩ + ৯ + ২৭ +..............."],"a":1,"e":"","id":"q11542cd8b4","t":"l","s":""},{"q":"(2/√5), - 2, 2√5, - 10, ............ ধারাটির সপ্তম পদ কত?","o":["- 45√5","- 40","25√5","50√5"],"a":3,"e":"","id":"q1177bdf320","t":"l","s":""},{"q":"পাঁচটি পদের একটি সমান্তর ধারার পঞ্চম পদটি হল ১০। তাদের যোগফল ৩০ হলে, প্রথম পদটি কত?","o":["৬","-২","৪","২"],"a":3,"e":"","id":"q11c78a28ed","t":"l","s":""},{"q":"একটি সমান্তর অনুক্রমে সাধারণ অন্তর 5 এবং তৃতীয় পদ 30 হলে অষ্টম পদ কত?","o":["55","68","48","72"],"a":0,"e":"","id":"q11cc432580","t":"l","s":""},{"q":"1/2, 3/4, 5/6, 7/8, ….......... এর সাধারণ পদ কোনটি?","o":["(2n + 1)/(2n)","(n - 1)/n","(2n - 1)/2n","n/(2n)"],"a":2,"e":"","id":"q12474e98a0","t":"l","s":""},{"q":"How many terms of Arithmetic Progression 21, 18, 15, 12 ............. must be taken to give the sum zero?","o":["15","22","10","12"],"a":0,"e":"ধারাটির প্রথম পদ 21 ও সাধারণ অন্তর -3। n পদের সমষ্টির সূত্র (n/2){2a + (n - 1)d} শূন্যের সমান ধরলে (n/2)(45 - 3n) = 0 পাওয়া যায়। n = 0 গ্রহণযোগ্য নয়, তাই 45 - 3n = 0 থেকে n = 15। এর ব্যাখ্যা: ধারার ১১তম পদের পর পদগুলো ঋণাত্মক হয়ে ধনাত্মক অংশকে কাটতে থাকে এবং ১৫টি পদে সমষ্টি শূন্য হয়।","id":"q12521010c6","t":"l","s":""},{"q":"১ + ৩ + ৫ + ........... + ২৫ = কত?","o":["১৮৯","৩৪৭","২১০","১৬৯"],"a":3,"e":"","id":"q1259bbdeef","t":"l","s":""},{"q":"কোনো ধারার প্রথম n সংখ্যক পদের সমষ্টি n(n + 1) হলে, ধারাটির প্রথম 15 টি পদের সমষ্টি কত?","o":["320","420","280","240"],"a":3,"e":"","id":"q12ae70380d","t":"l","s":""},{"q":"(1/4) - (1/6) + (1/9) - (2/7) + ………. ধারাটির সাধারণ অনুপাতের ক্ষেত্রে কোনটি সঠিক হবে?","o":["সাধারণ অনুপাত ০ অপেক্ষা বড় হবে","সাধারণ অনুপাত ধনাত্মক হবে","সাধারণ অনুপাত 1 অপেক্ষা বড় হবে","সাধারণ অনুপাত ০ অপেক্ষা ছোট হবে"],"a":3,"e":"","id":"q1345975a89","t":"l","s":""},{"q":"3 + 6 + 12 + 24 + …... ধারাটির 9ম পদ কত?","o":["768","1296","384","1536"],"a":0,"e":"","id":"q138eea6509","t":"l","s":""},{"q":"7 + (7/2) + (7/4) + (7/8) + ...... ধারাটির অসীমতক পদের সমষ্টি কত?","o":["1/2","21","1/7","14"],"a":3,"e":"","id":"q139963a526","t":"l","s":""},{"q":"1 2 + 2 2 + 3 2 + 4 2 + ......+(n - 1) 2 =?","o":["n (n - 1) (2n - 1)/6","n(n + 1)/2","n(n + 1)(2n + 1)/6","n(n + 1)(2n + 1)/2"],"a":0,"e":"","id":"q13edc6d936","t":"l","s":""},{"q":"In an AP, the ratio of the 2nd term to the 7th term is 1/3. If the 5th term is 11, what is the 15th term?","o":["31","28","36","33"],"a":0,"e":"(a + d)/(a + 6d) = 1/3 থেকে 3a + 3d = a + 6d, তাই 2a = 3d। 5ম পদ a + 4d = 11 হওয়ায় 3d/2 + 4d = 11, ফলে d = 2 ও a = 3। 15-তম পদ = 3 + 14 × 2 = 31।","id":"q14dfdc5d78","t":"l","s":""},{"q":"কোন গুণোত্তর ধারার তৃতীয় পদ 6 হলে, প্রথম 5 টি পদের গুনফল কত?","o":["7771","7776","7737","7171"],"a":1,"e":"","id":"q15ec904267","t":"l","s":""},{"q":"1 + 1/3 + 1/9 + .... ধারাটির কততম পদের মান 1/729?","o":["8","9","6","7"],"a":3,"e":"","id":"q15eea2bfc8","t":"l","s":""}]
