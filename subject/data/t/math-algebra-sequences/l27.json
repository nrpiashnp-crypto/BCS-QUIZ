[{"q":"For a geometric sequence, the first term a = 5 and the common ratio r = 3. What is the sum of the first 4 terms?","o":["240","180","200","125"],"a":2,"e":"গুণোত্তর ধারায় r > 1 হলে n পদের যোগফল S = a(rⁿ − 1)/(r − 1)। এখানে a = 5, r = 3, n = 4 বসালে 5 × (81 − 1)/2 = 5 × 40 = 200। সরাসরি যোগ করেও মেলে: 5 + 15 + 45 + 135 = 200।","id":"q6b694d013f","t":"l","s":""},{"q":"169 + 171 + 173 + ...... + 209 ধারাটির পদ সংখ্যা কত?","o":["21","24","19","20"],"a":0,"e":"","id":"q6b97cee908","t":"l","s":""},{"q":"১. ১, ৫, ৯, ..........., ৮১ ধারাটির সংখ্যাগুলোর গড় কত?","o":["৪২","৪০","৪১","৩৯"],"a":2,"e":"","id":"q6bcf721962","t":"l","s":""},{"q":"কোনো সমান্তর ধারার প্রথম পদ ২২ এবং ২য় পদ ২৭ হলে ৫ম পদ কত?","o":["২২","২০","৪৪","৪২"],"a":3,"e":"","id":"q6be679c433","t":"l","s":""},{"q":"০, ৩, ৮, ১৫, ...... ধারাটির ৭ম পদ কত?","o":["৪৮","৩৫","৬৩","৬০"],"a":0,"e":"","id":"q6c37d183d7","t":"l","s":""},{"q":"1 + 0.5 + 0.25 + 0.125 + 0.0625 +........... ধারাটির অসীমতক সমষ্টি কত?","o":["5","4","2","3"],"a":2,"e":"","id":"q6cac6d0af3","t":"l","s":""},{"q":"একটি সমান্তর ধারার প্রথম 10 টি সংখ্যার যোগফল 185 এবং এর প্রথম পদ 5 হলে, সাধারণ অন্তর কত?","o":["5","4","3","8"],"a":2,"e":"","id":"q6cc097c3e0","t":"l","s":""},{"q":"128 + 64 + 32 + …….. ধারাটির কোন পদ 1/2?","o":["5","7","9","None of them"],"a":2,"e":"","id":"q6cc181eb71","t":"l","s":""},{"q":"4 + 8 + 16 +32 ........ ধারাটির 8 তম পদ কত?","o":["643","524","610","512"],"a":3,"e":"","id":"q6cf20219db","t":"l","s":""},{"q":"একটি সমান্তর অনুক্রমে ৬ষ্ঠ পদটি 20 এবং প্রথম ৬টি পদের যোগফল 90 হয়, তাহলে প্রথম পদটি কত?","o":["8","10","5","4"],"a":1,"e":"","id":"q6d33fc1197","t":"l","s":""},{"q":"১ থেকে ৫০ পর্যন্ত পূর্ণসংখ্যা সমূহের সমষ্টি কত?","o":["৫০৫০","১২৭৫","২৫৫০","১৫৫০"],"a":1,"e":"","id":"q6d49dcf108","t":"l","s":""},{"q":"কোনটি গুণোত্তর ধারা নয়?","o":["৩ + ৬ + ৯ + .....................","(১/২) + (১/৪) + (১/৮) + ................","৩ + ৬ + ১২ + .......................","২ + ৪ + ৮ + ..........."],"a":0,"e":"","id":"q6d74a55392","t":"l","s":""},{"q":"What is the difference between the 5 th and the 4 th terms of the sequence 2, 4, 7, ____ whose n th term is n + 2 (n - 1) ?","o":["17","15","9","5"],"a":2,"e":"সূত্র aₙ = n + 2^(n−1) (ঘাত চিহ্ন প্রশ্নে হারিয়ে গেছে)। a₄ = 4 + 2³ = 12 এবং a₅ = 5 + 2⁴ = 21। পার্থক্য 21 − 12 = 9। শুরুর তিন পদ 2, 4, 7 এই সূত্রে মেলে।","id":"q6d875cd06b","t":"l","s":""},{"q":"3 + 7 + 11 + 15 +......... ধারাটির n পদের সমষ্টি কত?","o":["n(3n + 1)/2","n(2n - 1)","n(2n + 1)","n(n + 3)"],"a":2,"e":"","id":"q6e492c5b9f","t":"l","s":""},{"q":"একটি গুণোত্তর ধারার ১ম পদ ও ২য় পদ যথাক্রমে 64 এবং 16 হলে ধারাটির পঞ্চম পদ কত?","o":["1/4","4","1/8","1/12"],"a":0,"e":"","id":"q6e548b26ab","t":"l","s":""},{"q":"8 + 14 + 20 + 26 + …............... ধারাটির প্রথম 30 টি পদের সমষ্টি কত?","o":["2920","2800","2850","2950"],"a":2,"e":"","id":"q6e9c786179","t":"l","s":""},{"q":"৮, ২৪, ৪৮, ৮০, ... ধারাটির পরবর্তী সংখ্যাটি কত?","o":["১১২","১২০","৯৪","৯৮"],"a":1,"e":"","id":"q6e9df8b4c6","t":"l","s":""},{"q":"13, 18, 23, 28............ধারাটির কোন পদ 108?","o":["20 তম","21 তম","19 তম","18 তম"],"a":0,"e":"","id":"q6eb626d061","t":"l","s":""},{"q":"৫ + ৯ + ১৩ + ১৭ +........................... ধারাটিতে কততম পদ ১৭৩?","o":["৪১ তম","৪৩ তম","৪২ তম","৪৪ তম"],"a":1,"e":"","id":"q6ecb0ce65f","t":"l","s":""},{"q":"1 + 2 + 3 + ..................... + 75 পর্যন্ত সংখ্যাগুলোর যোগফল কত?","o":["2775","2650","2850","2575"],"a":2,"e":"","id":"q6ee0b91c63","t":"l","s":""}]
