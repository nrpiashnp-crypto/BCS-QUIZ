[{"q":"In an AP, the sum of the first 3 terms is - 36 and that of the last 3 is 27. If there are 10 terms, what is the 1st term?","o":["- 11","- 12","- 15","- 13"],"a":2,"e":"প্রথম তিন পদের যোগ 3a + 3d = −36, তাই a + d = −12। শেষ তিন পদ a + 7d, a + 8d, a + 9d-এর যোগ 3a + 24d = 27, তাই a + 8d = 9। দ্বিতীয় থেকে প্রথম বিয়োগ করলে 7d = 21, d = 3। তখন a = −12 − 3 = −15।","id":"q8bfbeacfeb","t":"l","s":""},{"q":"2 + 6 + 18 + ধারাটির ৬ষ্ঠ পদের সমষ্টি কত?","o":["528","428","442","728"],"a":3,"e":"","id":"q8c31a30d21","t":"l","s":""},{"q":"১,১,২,৩,৫…… ধারার দশম পদ কত?","o":["২১","৩৪","৫৫","১৩"],"a":2,"e":"","id":"q8c52deb7a5","t":"l","s":""},{"q":"8 + 16 + 24 + ⋯ + 96 ধারাটির মোট পদসংখ্যা কত?","o":["12","9","14","17"],"a":0,"e":"","id":"q8cd63364cb","t":"l","s":""},{"q":"1 + 1/2 + 1/4 + 1/8 + …………. গুণোত্তর ধারাটির ৮ম পদ কত?","o":["1/128","1/64","1/32","0.016"],"a":0,"e":"","id":"q8d7abd6c38","t":"l","s":""},{"q":"2 - 4 + 8 -16 + ……… ধারাটির ১ম নয়টি পদের সমষ্টি কত?","o":["342","86","184","171"],"a":0,"e":"","id":"q8dbfb0c85e","t":"l","s":""},{"q":"8 + 11 + 14 + 17 +........... ধারাটির কোন পদ 368?","o":["121","122","119","120"],"a":0,"e":"","id":"q8e2209f7de","t":"l","s":""},{"q":"7 + 12 + 17 + 22 + ....… ধারাটির 20তম পদ কত?","o":["102","107","97","92"],"a":0,"e":"","id":"q8e79c062cb","t":"l","s":""},{"q":"2 + 4 + 8 + ................. ধারাটির প্রথম 6টি পদের সমষ্টি কত?","o":["128","126","62","254"],"a":1,"e":"","id":"q8f8e440804","t":"l","s":""},{"q":"একটি সমান্তর ধারার ৪র্থ পদ ১৯ এবং ৬ষ্ঠ পদ ২৭ হলে, ধারাটির ২য় পদ কত?","o":["৭","১২","১১","১৩"],"a":2,"e":"","id":"q902444dc74","t":"l","s":""},{"q":"7 + 13 + 19 + . . . . ধারাটির কোন পদ 319 হবে?","o":["63 তম","53 তম","49 তম","59 তম","51 তম"],"a":1,"e":"","id":"q9027c7e2ca","t":"l","s":""},{"q":"একটি গুণোত্তর ধারার ৩য় পদটি 12 এবং পঞ্চম পদটি 3/4 হলে, সাধারণ অনুপাত কত?","o":["1/2","1/4","1/3","1/8"],"a":1,"e":"","id":"q90281a845c","t":"l","s":""},{"q":"কোনো সমান্তর ধারার m- তম পদ n এবং n- তম পদ m হলে, (m + n) তম পদ কত?","o":["0"