উৎপাদক?","o":["p - 2","p - 1","p - 3","p - 4"],"a":0,"e":"","id":"qbfc527bdca","t":"l","s":""},{"q":"x 3 + 3x 2 + 3x + 2 এর সঠিক উৎপাদকে বিশ্লেষণ হলো-","o":["(x - 2)(x 2 + x - 1)","(x - 2)(x 2 - x + 1)","(x + 2)(x 2 + x + 1)","(x + 1)(x 2 + x + 2)"],"a":2,"e":"","id":"qc076e8dd78","t":"l","s":""},{"q":"নিচের কোনটি 3a 2 - 4a - 15 এর একটি উৎপাদক?","o":["(a + 3)","(3a + 5)","(a - 9)","(5a - 3)"],"a":1,"e":"","id":"qc155e38c84","t":"l","s":""},{"q":"x³ − 27 রাশিটির একটি উৎপাদক কোনটি?","o":["x² + 3x + 9","x² − 3x + 9","x² + 9","x − 9"],"a":0,"e":"27 = 3³, তাই x³ − 27 = x³ − 3³। ঘনের অন্তরের সূত্র a³ − b³ = (a − b)(a² + ab + b²) ব্যবহার করে পাই, x³ − 3³ = (x − 3)(x² + 3x + 9)।\nসুতরাং একটি উৎপাদক x² + 3x + 9। চিহ্ন মনে রাখতে হয়: প্রথম বন্ধনীতে বিয়োগ থাকলে দ্বিতীয় বন্ধনীর মাঝের পদ যোগ হয়।\nমনে রাখুন:\na³ + b³ = (a + b)(a² − ab + b²)","id":"qc1c160bc60","t":"l","s":""},{"q":"2a 2 - 3a - 2 এর একটি উৎপাদক (a - 2) হলে অপরটি হবে-","o":["(2a + 3)","(2a + 1)","(2a - 1)","(3a - 2)"],"a":1,"e":"","id":"qc1c4e20b13","t":"l","s":""},{"q":"6x 2 - 7x - 5 এর উৎপাদক নিচের কোনটি?","o":["(2x + 5) (3x - 1)","(3x + 5) (2x - 1)","(2x - 5) (3x + 1)","(3x - 5) (2x + 1)"],"a":3,"e":"","id":"qc1f2507709","t":"l","s":""},{"q":"2x 2 + x -15 এর উৎপাদক কোনটি?","o":["(x-3)(2x+5)","(x+3)(2x-5)","(x-3)(2x-5)","(x+3)(2x+5)"],"a":1,"e":"","id":"qc1f7a61402","t":"l","s":""},{"q":"- 16x + 3x 2 - 12 এর একটি উৎপাদক হলো-","o":["(3x + 3)","(2x + 3)","(3x + 2)","(4x + 6)"],"a":2,"e":"","id":"qc24c60f8c2","t":"l","s":""},{"q":"2a - 32a 3 এর একটি উৎপাদক নয় কোনটি?","o":["2a","2a - 1","1 - 4a","1 + 4a"],"a":1,"e":"","id":"qc3a70cf364","t":"l","s":""}]
