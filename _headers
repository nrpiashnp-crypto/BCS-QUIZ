/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com https://static.cloudflareinsights.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://accounts.google.com https://cdnjs.cloudflare.com; font-src 'self' data: https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self' https://accounts.google.com https://cloudflareinsights.com https://static.cloudflareinsights.com https://script.google.com https://script.googleusercontent.com; frame-src https://accounts.google.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
/img/*
  Cache-Control: public, max-age=604800
/sample/*
  Cache-Control: public, max-age=86400
/js/*
  Cache-Control: public, max-age=3600
/css/*
  Cache-Control: public, max-age=3600
/sw.js
  Cache-Control: no-cache
/.well-known/assetlinks.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600
/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/challenge/*
  X-Robots-Tag: noindex
/pilot/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache
/c/*
  X-Robots-Tag: noindex
